#!/usr/bin/env node
"use strict";

// pane-send — the one shared send path for zmx panes (Claude Code TUIs):
// PAV's backend, the coordinator and a human all type through this script,
// never a second send path. Three modes:
//
//   send <session> [text]     chunks + a separate Enter, verified in the
//                             transcript (a mismatch fails loud, never retries);
//                             the text is flattened (newlines become spaces)
//   paste <session> [text]    chunks wrapped once in bracketed-paste markers
//                             (ESC[200~ ... ESC[201~), the raw text with
//                             newlines preserved, no flatten, no Enter (first
//                             messages and proposed drafts are offered
//                             unsent); verify is report-only
//   answer <session> --option <key>
//                             one keystroke to a permission prompt, verified in
//                             the pane tail (read, re-read unchanged, send,
//                             re-read: prompt gone and new output appeared);
//                             --expect-prompt-hash pins the prompt by the
//                             SHA-256 of its block; a verified answer clears
//                             the session's needs_input (the keystroke fires
//                             no prompt-submit)
//
// Preconditions, checked in this order, each refusal naming its cause on
// stderr and exiting 2: the session resolves in zmx AND the engine registry;
// the engine's session state is needs_input (a row gone stale — a transcript
// turn ran after the signal — reads live) or the pane is fresh-empty (a
// mid-turn session is refused — the TUI queues typed input); the pane's input
// box is empty (the grey suggestion renders dim and reads as empty); the
// text never starts with /clear; a send or paste into a gate-awaiting session
// (fresh needs_input + the task's pending question) is refused unless
// --decision-id names a decide row that exists, is at most 5 minutes old,
// quotes the owner's words, decides the target's task, is not waived, and
// was recorded by nobody or the invoking session — the flag is validated
// whenever present, whatever the state. A prompt answer without
// --expect-prompt-hash passes with one advisory line on stderr. PAV binds
// the advice hash at click and refuses while the owner is typing — those
// stay in PAV; this script is the shared floor, not the ceiling.
//
// Exit codes: 0 sent and verified; 1 sent or verified and failed; 2 refused.

const fs = require("fs");
const { execFileSync } = require("child_process");

// The pane reads live in ../lib/pane (the one shared read path); the bin owns
// the exits — a failed read refuses exactly as it always did.
const pane = require("../lib/pane");
const {
  PROMPT_MARKERS, PANE_TAIL_LINES, stripEscapes, promptPresent, inputLineOf, promptBlockOf,
} = pane;

function paneVtLines(session) {
  try { return pane.paneVtLines(session); } catch (err) { refuse(err.message); }
}

function paneLines(session) {
  try { return pane.paneLines(session); } catch (err) { refuse(err.message); }
}

// The bracketed-paste markers: the TUI consumes them, so the pane receives
// the wrapped text as one multi-line paste sitting unsent in its input box —
// the same byte stream a terminal paste (and PAV's paste_input) produces.
const PASTE_OPEN = "\x1b[200~";
const PASTE_CLOSE = "\x1b[201~";

const DECISION_MAX_AGE_MS = 5 * 60 * 1000;
const POLL_STEP_SECS = 0.25;
const DEFAULTS = {
  chunkChars: 200,
  pauseSecs: 0.3,
  sendVerifySecs: 10,
  answerVerifySecs: 5,
  pasteVerifySecs: 2,
  zmxTimeoutMs: pane.ZMX_TIMEOUT_MS,
};

// One keystroke: a single letter or digit (the numbered options), or "enter".
const OPTION_KEY_RE = /^[0-9a-zA-Z]$|^enter$/;

function usage() {
  return [
    "pane-send — the one shared send path for zmx panes",
    "",
    "Usage:",
    "  pane-send send <session> [text ...] [--decision-id <id>] [--chunk-chars <n>] [--pause-secs <s>] [--verify-secs <s>]",
    "  pane-send paste <session> [text ...] [--chunk-chars <n>] [--pause-secs <s>]",
    "  pane-send answer <session> --option <key> [--expect-prompt-hash <hex>] [--verify-secs <s>]",
    "",
    "Text comes from the arguments (joined with spaces) or, when none is given, stdin.",
    "Defaults: chunk 200 chars, pause 0.3s, verify 10s (send) / 5s (answer) / 2s report-only (paste).",
    "Every mode checks: the session resolves in zmx and the engine registry; the",
    "engine state is needs_input or the pane is fresh-empty; the input box is empty;",
    "the text never starts with /clear; a send or paste into a gate-awaiting session",
    "(fresh needs_input + the task's pending question) refuses without --decision-id.",
    "A --decision-id row must exist, be <= 5 minutes old, quote the owner's words,",
    "decide the target's task, not be waived, and be recorded by nobody or this",
    "session (CLAUDE_CODE_SESSION_ID) — validated whenever present, whatever the state.",
    "A prompt answer without --expect-prompt-hash passes with an advisory on stderr.",
  ].join("\n");
}

function refuse(message) {
  process.stderr.write(`pane-send: ${message}\n`);
  process.exit(2);
}

function fail(message) {
  process.stderr.write(`pane-send: ${message}\n`);
  process.exit(1);
}

// The reference flatten (zmx-send-chunked.py): trim the whole text, one
// newline becomes one space — interior blank lines stay as double spaces.
// Send mode only; paste sends the raw text wrapped in the paste markers.
function flattenText(text) {
  return String(text).replace(/\r\n?/g, "\n").trim().split("\n").join(" ");
}

function chunkText(text, n) {
  const size = Math.max(1, Math.floor(n));
  const out = [];
  for (let i = 0; i < text.length; i += size) out.push(text.slice(i, i + size));
  return out;
}

function sleep(seconds) {
  execFileSync("/bin/sleep", [String(seconds)], { stdio: ["ignore", "ignore", "ignore"] });
}

// ---------------------------------------------------------------- zmx plumbing

function zmxSessions() {
  const start = require("../lib/start");
  try {
    return start.zmxSessions();
  } catch (err) {
    if (err && err.code === "zmx_timeout") refuse("zmx list is slow (timed out twice); retry in a moment");
    refuse(`zmx list failed: ${err.message}`);
  }
  return null;
}

function zmxSend(session, text) {
  try {
    execFileSync("zmx", ["send", session], {
      input: text, encoding: "utf8", timeout: DEFAULTS.zmxTimeoutMs, stdio: ["pipe", "pipe", "pipe"],
    });
  } catch (err) {
    const why = err.stderr ? String(err.stderr).trim() : err.message;
    fail(`zmx send failed for ${session}: ${why}`);
  }
}

// ---------------------------------------------------------------- resolution and preconditions

function escapeRegExp(s) {
  return String(s).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

// Whether a registration claims this pane name (the engine's own matching
// rule, roster.js zmxLive: the recorded mux name, or the shell-launcher name
// `<Agent>-<first 8 of the session id>[-rN]`). Liveness never enters — an
// ended registration still claims its pane, and the state check refuses it.
function claimsName(reg, name) {
  if (reg.mux && reg.mux.kind === "zmx" && reg.mux.name) return reg.mux.name === name;
  if (!reg.mux && reg.session_id) {
    return new RegExp(`-${escapeRegExp(String(reg.session_id).slice(0, 8))}(-r\\d+)?$`).test(name);
  }
  return false;
}

// Resolve a pane name to its engine registration entry {dir, registration},
// read-only: zmx must list the session live, and exactly one registration
// must claim it. The dir is the registration's own folder — launcher folders
// are named by terminal id, so a session-id path lookup would miss them.
function resolveSession(name) {
  const session = require("../lib/session");
  const zmx = zmxSessions();
  if (zmx === null) refuse("zmx is unavailable (`zmx list` did not answer)");
  const zmxEntry = zmx.find((s) => s.name === name);
  if (!zmxEntry) refuse(`no zmx session named "${name}"`);
  if (zmxEntry.ended) refuse(`zmx session "${name}" has ended`);
  const matched = session.entries().filter((e) => claimsName(e.registration, name));
  if (matched.length === 0) refuse(`no engine registration matches zmx session "${name}"`);
  if (matched.length > 1) refuse(`${matched.length} engine registrations match zmx session "${name}"; refusing to pick one`);
  return matched[0];
}

// The engine's state word for the registration, with the pane live.
function stateWordOf(reg) {
  const session = require("../lib/session");
  const derive = require("../lib/derive");
  return derive.sessionState(reg, { alive: session.isLive(reg), zmxLive: true });
}

// A pane that never had a turn: the registration's transcript holds no typed
// user entry — the file may exist with bookkeeping rows only. The empty box
// alone cannot tell a fresh pane from a mid-turn one whose suggestion
// rendered; a turn that ran leaves the user entry that started it.
function neverHadATurn(reg) {
  if (!reg || !reg.transcript_path) return true;
  return transcriptEntries(reg.transcript_path).every((e) => typedTextOf(e) === null);
}

// Preconditions 1-3 for every mode; returns the first pane tail read, plain.
// `state` is computed once by the caller and threaded through — the binding's
// advisory consults it too.
function preconditions(name, reg, state) {
  const vt = paneVtLines(name);
  const lines = vt.map(stripEscapes);
  const prompt = promptPresent(lines);
  const input = inputLineOf(vt);

  if (state === "gone") {
    refuse(`the engine's session state for "${name}" is gone (ended or not live)`);
  }
  if (state !== "needs_input") {
    const freshEmpty = !prompt && input !== null && input.empty && neverHadATurn(reg);
    if (!freshEmpty) {
      refuse(
        `the engine's session state for "${name}" is ${state} and the pane is not fresh-empty; ` +
        "a mid-turn session is refused because the TUI queues typed input"
      );
    }
  }
  if (prompt) {
    // The permission prompt owns the keyboard; there is no free input to clobber.
  } else if (input === null) {
    refuse(`the pane tail for "${name}" shows no input box line; cannot prove the input is empty`);
  } else if (!input.empty) {
    refuse(`the input box for "${name}" is not empty (last input line: ${JSON.stringify(input.line)})`);
  }
  return lines;
}

// A decide row by id, read-only; the validation lives in validateDecisionId.
function decideRowById(id) {
  const db = require("../lib/db");
  let conn;
  try {
    conn = db.open({ readonly: true });
  } catch (err) {
    if (err && err.notFound) refuse(`no database at ${db.dbPath()}: no decide row backs this send`);
    throw err;
  }
  try {
    return conn.get("SELECT * FROM decisions WHERE decision_id = ?", id) || null;
  } finally {
    try { conn.raw.close(); } catch { /* already closed */ }
  }
}

// The pending gate on the target's task, when the session is needs_input and
// the task's advice asks the owner a question — the state a gate word
// answers. One adviceFor per gate-candidate send, only on a lit row; an
// unreadable task can hold no gate.
function gateOf(reg, state) {
  if (state !== "needs_input" || !reg || !reg.task_dir) return null;
  try {
    return require("../lib/advise").adviceFor(reg.task_dir).question;
  } catch {
    return null;
  }
}

// Validate the decide row a --decision-id names, whenever the flag is
// present, whatever the pane's state: exists, integer, at most 5 minutes
// old, non-empty quote, the target session's task, not a waived row, and
// recorded by nobody (the owner's own words) or by the invoking session.
function validateDecisionId(name, reg, decisionId) {
  if (!Number.isInteger(decisionId)) {
    refuse(`--decision-id must be a decision id number (got ${JSON.stringify(decisionId)})`);
  }
  const row = decideRowById(decisionId);
  if (row === null) refuse(`--decision-id ${decisionId} names no decide row`);
  if (!row.quote || !String(row.quote).trim()) refuse(`--decision-id ${decisionId} has an empty quote`);
  const ageMs = Date.now() - Date.parse(row.decided_at);
  if (!(ageMs >= 0 && ageMs <= DECISION_MAX_AGE_MS)) {
    refuse(
      `--decision-id ${decisionId} is ${Math.round(Math.abs(ageMs) / 60000)} minutes old; ` +
      `a decide row backs a send for at most ${DECISION_MAX_AGE_MS / 60000} minutes`
    );
  }
  const db = require("../lib/db");
  const taskId = reg && reg.task_dir ? db.taskIdOf(reg.task_dir) : null;
  if (row.task_id !== taskId) {
    refuse(`--decision-id ${decisionId} decides another task than the one "${name}" is bound to`);
  }
  if (row.choice === "waived") {
    refuse(`--decision-id ${decisionId} is a waived row; a waived phase asks for no gate word`);
  }
  const caller = process.env.CLAUDE_CODE_SESSION_ID || null;
  if (row.recorded_by !== null && row.recorded_by !== caller) {
    refuse(`--decision-id ${decisionId} was recorded by another session (${JSON.stringify(row.recorded_by)})`);
  }
  return row;
}

// Preconditions on the text as sent (send's flattened, paste's raw), in
// order: the /clear refusal, the --decision-id validation whenever the flag
// is present, and the gate refusal — a gate-awaiting session sends nothing
// unbound. The text is never matched: the gate state alone decides.
function textPreconditions(name, reg, text, decisionId, state) {
  // trimStart: paste sends the raw text, so a /clear hiding behind leading
  // blank lines is caught on the text as pasted, not only post-flatten.
  if (text.trimStart().startsWith("/clear")) {
    refuse(`the text starts with /clear; /clear is refused always (pane "${name}")`);
  }
  const backed = decisionId === undefined ? false : validateDecisionId(name, reg, decisionId) !== null;
  if (!backed) {
    const gate = gateOf(reg, state);
    if (gate) {
      refuse(
        `the send is unbound: "${name}" waits on its task's gate ("${gate.text}"); ` +
        "pass --decision-id naming a decide row at most 5 minutes old that carries the owner's words"
      );
    }
  }
}

// ---------------------------------------------------------------- transcript verify

// The last typed user message and any qualifying one: type user, not
// sidechain, content a string or all-text blocks (129-watch's rule).
function typedTextOf(entry) {
  if (!entry || entry.type !== "user" || entry.isSidechain) return null;
  const content = entry.message && entry.message.content;
  if (typeof content === "string") return content;
  if (Array.isArray(content) && content.every((b) => b && b.type === "text")) {
    return content.map((b) => b.text || "").join("\n");
  }
  return null;
}

function transcriptEntries(path) {
  let raw;
  try {
    raw = fs.readFileSync(path, "utf8");
  } catch {
    return [];
  }
  const out = [];
  for (const line of raw.split("\n")) {
    if (!line.trim()) continue;
    try { out.push(JSON.parse(line)); } catch { /* a torn trailing line is mid-write */ }
  }
  return out;
}

// Poll for a user message at/after startIso whose typed text is at least
// `minChars` long — the write lags the Enter, so this waits, never misreads.
function pollTranscript(path, startIso, minChars, budgetSecs) {
  const deadline = Date.now() + budgetSecs * 1000;
  for (;;) {
    const entries = transcriptEntries(path);
    let newest = null;
    let qualifying = null;
    for (const e of entries) {
      const text = typedTextOf(e);
      if (text === null) continue;
      const at = e.timestamp || "";
      newest = { at, text };
      if (at >= startIso && text.length >= minChars && qualifying === null) qualifying = { at, text };
    }
    if (qualifying !== null) return { ok: true, qualifying, newest };
    if (Date.now() >= deadline) return { ok: false, newest };
    sleep(POLL_STEP_SECS);
  }
}

// ---------------------------------------------------------------- the modes

function modeSend(name, reg, text, flags) {
  let transcriptPath;
  try {
    transcriptPath = require("../lib/adapter").forHarness().transcript(reg);
  } catch (err) {
    refuse(`the harness adapter failed to name a transcript for "${name}": ${err.message}`);
  }
  if (!transcriptPath) {
    refuse(`the registration for "${name}" has no transcript path; a send must be verifiable`);
  }
  const chunkChars = flags["--chunk-chars"] !== undefined ? Number(flags["--chunk-chars"]) : DEFAULTS.chunkChars;
  const pauseSecs = flags["--pause-secs"] !== undefined ? Number(flags["--pause-secs"]) : DEFAULTS.pauseSecs;
  const verifySecs = flags["--verify-secs"] !== undefined ? Number(flags["--verify-secs"]) : DEFAULTS.sendVerifySecs;
  const chunks = chunkText(text, chunkChars);
  const startIso = new Date().toISOString();
  for (const piece of chunks) {
    zmxSend(name, piece);
    sleep(pauseSecs);
  }
  sleep(Math.max(pauseSecs, 0.5));
  zmxSend(name, "\r");

  const result = pollTranscript(transcriptPath, startIso, text.length, verifySecs);
  if (!result.ok) {
    const newest = result.newest;
    const foundLine = newest
      ? `found ${newest.text.length} chars (the newest user message, at ${newest.at || "no timestamp"})`
      : "found no typed user message at all";
    process.stderr.write(
      `pane-send: verify failed — no user message of at least ${text.length} chars at/after ${startIso} within ${verifySecs}s in ${transcriptPath}\n` +
      `expected >= ${text.length} chars; ${foundLine}\n` +
      `pane tail (last ${PANE_TAIL_LINES} lines of zmx history ${name}):\n${paneLines(name).join("\n")}\n`
    );
    process.exit(1);
  }
  process.stdout.write(
    `sent ${text.length} chars in ${chunks.length} chunks to ${name} ` +
    `(chunk ${chunkChars}, pause ${pauseSecs}s); the transcript shows a ${result.qualifying.text.length}-char user message at ${result.qualifying.at}\n`
  );
  process.exit(0);
}

function modePaste(name, text, flags) {
  const chunkChars = flags["--chunk-chars"] !== undefined ? Number(flags["--chunk-chars"]) : DEFAULTS.chunkChars;
  const pauseSecs = flags["--pause-secs"] !== undefined ? Number(flags["--pause-secs"]) : DEFAULTS.pauseSecs;
  const chunks = chunkText(text, chunkChars);
  // One bracketed-paste wrap around the whole text: the opening marker rides
  // the first chunk, the closing marker the last, so whatever the chunking
  // the pane receives ESC[200~ + text + ESC[201~ byte for byte — the stream
  // a terminal paste (and paste_input) writes, newlines preserved.
  for (let i = 0; i < chunks.length; i++) {
    let piece = chunks[i];
    if (i === 0) piece = PASTE_OPEN + piece;
    if (i === chunks.length - 1) piece = piece + PASTE_CLOSE;
    zmxSend(name, piece);
    sleep(pauseSecs);
  }
  sleep(Math.max(pauseSecs, 0.5));

  // Report-only: the pane tail should show the body's tail. A raw body can
  // end in newlines, so trailing whitespace leaves the sig; wrapping can
  // split the sig across lines, so whitespace collapses on both sides.
  const sig = text.replace(/\s+$/, "").slice(-20);
  const collapse = (s) => s.replace(/\s+/g, "");
  const deadline = Date.now() + DEFAULTS.pasteVerifySecs * 1000;
  let shown = false;
  for (;;) {
    const tail = paneLines(name).join("\n");
    shown = collapse(tail).includes(collapse(sig));
    if (shown || Date.now() >= deadline) break;
    sleep(POLL_STEP_SECS);
  }
  const summary = `paste ${text.length} chars in ${chunks.length} chunks to ${name} (no Enter; offered unsent)`;
  if (shown) {
    process.stdout.write(`${summary}; the pane tail shows the final chunk\n`);
  } else {
    process.stdout.write(
      `${summary}; warning: the pane tail does not show the final chunk (last ${PANE_TAIL_LINES} lines below)\n` +
      `${paneLines(name).join("\n")}\n`
    );
  }
  process.exit(0);
}

// Clear the needs-input signal the way the UserPromptSubmit hook does — the
// same clearSignal the hook calls (prompt-submit.js). The answer keystroke
// fires no prompt-submit, so without this the roster row would stay lit
// until the session's next prompt. Reached only on a verified answer; a
// failed write warns and never fails the answer (the keystroke landed).
function clearNeedsInput(name, entry) {
  const session = require("../lib/session");
  try {
    return session.clearSignal(entry.dir);
  } catch (err) {
    process.stderr.write(`pane-send: the answer verified, but clearing needs_input for "${name}" failed: ${err.message}\n`);
    return false;
  }
}

function modeAnswer(name, flags) {
  const key = flags["--option"];
  if (typeof key !== "string" || !OPTION_KEY_RE.test(key)) {
    refuse(`--option must be one letter or digit (the numbered option), or "enter"`);
  }
  const verifySecs = flags["--verify-secs"] !== undefined ? Number(flags["--verify-secs"]) : DEFAULTS.answerVerifySecs;
  const expectHash = flags["--expect-prompt-hash"];

  const entry = resolveSession(name);
  const lines1 = preconditions(name, entry.registration, stateWordOf(entry.registration));
  const block1 = promptBlockOf(lines1);
  if (block1 === null) {
    refuse(`the pane tail for "${name}" shows no permission prompt (${PROMPT_MARKERS.map((m) => JSON.stringify(m)).join(" or ")})`);
  }

  // Re-read immediately before the keystroke: the prompt must still be there,
  // unchanged (the TOCTOU guard — someone typing or a replaced prompt).
  const lines2 = paneLines(name);
  const block2 = promptBlockOf(lines2);
  if (block2 === null) {
    refuse(`the permission prompt left the pane between the two reads (pane "${name}")`);
  }
  if (block2.text !== block1.text) {
    process.stderr.write(
      `pane-send: the pane changed between the read and the keystroke; refusing to answer a prompt that moved\n` +
      `pane tail (last ${PANE_TAIL_LINES} lines of zmx history ${name}):\n${lines2.join("\n")}\n`
    );
    process.exit(2);
  }

  // The prompt pane-send is about to keystroke, hashed: the caller hashed the
  // canonical block it showed the owner (marker + consecutive blank/option
  // lines, escapes stripped) — a mismatch means the pane moved on.
  const blockHash = require("crypto").createHash("sha256").update(block2.text).digest("hex");
  if (expectHash !== undefined) {
    if (expectHash !== blockHash) {
      refuse(
        `the prompt changed since it was shown (expected ${expectHash}, the pane holds ${blockHash}); ` +
        "re-read the pane and answer again"
      );
    }
  } else {
    process.stderr.write(
      `pane-send: advisory: answering "${name}" without --expect-prompt-hash; ` +
      "a prompt that changed since it was shown is answered anyway\n"
    );
  }

  zmxSend(name, key === "enter" ? "\r" : key);

  // Verify: the prompt is gone and new output appeared (a permission answer
  // writes no user message, so the pane tail is the evidence).
  const preLines = new Set(lines2.map((l) => l.trim()).filter(Boolean));
  const deadline = Date.now() + verifySecs * 1000;
  for (;;) {
    const after = paneLines(name);
    const gone = !promptPresent(after);
    const fresh = after.some((l) => l.trim() && !preLines.has(l.trim()));
    if (gone && fresh) {
      const cleared = clearNeedsInput(name, entry);
      process.stdout.write(
        `answered ${name} with "${key}"; the prompt left the pane and new output appeared` +
        (cleared ? "; the needs-input signal is cleared" : "") + "\n"
      );
      process.exit(0);
    }
    if (Date.now() >= deadline) {
      process.stderr.write(
        `pane-send: answer failed — after ${verifySecs}s the pane ${gone ? "shows no new output" : "still shows the prompt"}\n` +
        `pane tail (last ${PANE_TAIL_LINES} lines of zmx history ${name}):\n${after.join("\n")}\n`
      );
      process.exit(1);
    }
    sleep(POLL_STEP_SECS);
  }
}

// ---------------------------------------------------------------- CLI

const VALUE_FLAGS = new Set(["--decision-id", "--chunk-chars", "--pause-secs", "--verify-secs", "--option", "--expect-prompt-hash"]);

function parseArgs(argv) {
  const flags = {};
  const positional = [];
  let i = 0;
  while (i < argv.length) {
    const arg = argv[i];
    if (arg === "--") { positional.push(...argv.slice(i + 1)); break; }
    if (arg.startsWith("--")) {
      const eq = arg.indexOf("=");
      if (eq >= 0) { flags[arg.slice(0, eq)] = arg.slice(eq + 1); i++; }
      else if (VALUE_FLAGS.has(arg) && i + 1 < argv.length) { flags[arg] = argv[i + 1]; i += 2; }
      else { flags[arg] = true; i++; }
    } else { positional.push(arg); i++; }
  }
  return { flags, positional };
}

function main(argv) {
  const { flags, positional } = parseArgs(argv);
  if (flags["--help"] || flags["-h"]) { process.stdout.write(usage() + "\n"); process.exit(0); }
  const mode = positional[0];
  if (!mode) { process.stderr.write(usage() + "\n"); process.exit(2); }
  const name = positional[1];
  if (!name) refuse(`mode "${mode}" needs a zmx session name; usage:\n${usage()}`);

  let text = "";
  if (mode === "send" || mode === "paste") {
    const words = positional.slice(2);
    if (words.length > 0) text = words.join(" ");
    else if (!process.stdin.isTTY) text = fs.readFileSync(0, "utf8");
    // Send flattens (the typed-line contract); paste sends the raw text so
    // the pane receives a true multi-line paste.
    if (mode === "send") text = flattenText(text);
    if (text.trim() === "") refuse("refusing to send empty text");
    const entry = resolveSession(name);
    const state = stateWordOf(entry.registration);
    preconditions(name, entry.registration, state);
    textPreconditions(
      name, entry.registration, text,
      flags["--decision-id"] !== undefined ? Number(flags["--decision-id"]) : undefined, state
    );
    if (mode === "send") modeSend(name, entry.registration, text, flags);
    modePaste(name, text, flags);
  } else if (mode === "answer") {
    if (positional.length > 2) refuse("answer takes no text; the keystroke is --option");
    modeAnswer(name, flags);
  } else {
    process.stderr.write(`unknown mode "${mode}"\n${usage()}\n`);
    process.exit(2);
  }
}

module.exports = { PROMPT_MARKERS, DEFAULTS, flattenText, chunkText };

if (require.main === module) main(process.argv.slice(2));
