  { g: "repo", c: "key", d: "Resolve the repo key for a path.",
    f: [["--repo", false, "<path>", "path inside the repo (default: cwd)"]],
    ex: "a repo key --repo ." },
  { g: "tasks", c: "root", d: "Resolve the tasks root for a repo.",
    f: [["--repo", false, "<path>", "path inside the repo (default: cwd)"]],
