#!/usr/bin/env node
"use strict";

const path = require("path");
const fs = require("fs");
const { expandShort } = require("../lib/short-flags");

const VALUE_FLAGS = new Set([
  "--repo", "--path", "--cwd", "--agent", "--session-id", "--terminal-id", "--counter",
  "--title", "--slug", "--mode", "--task-dir", "--phase-id",
  "--owner", "--flag-id", "--type", "--message", "--worktree",
  "--pid", "--description", "--phases-json", "--blocked-by", "--parallel-group",
  "--initiator", "--repo-key", "--origin", "--transcript-path", "--source",
  "--previous-session-id", "--workflow-id", "--commitment-id", "--project-id",
  "--tmux-server", "--tmux-session", "--task",
  "--root", "--checkpoint-id", "--chosen", "--question", "--report-json",
  "--knob", "--value", "--file", "--plan-path", "--options-json",
  "--session-dir",
  "--name", "--commits",
  "--tier", "--older-than", "--since", "--status", "--out",
  "--run-id", "--brief", "--seconds", "--model", "--lines",
  "--choice", "--quote", "--text", "--check", "--policy",
]);

function parseArgs(argv) {
  const args = {};
  const positional = [];
  let i = 0;
  while (i < argv.length) {
    const arg = argv[i];
    if (arg === "--") {
      positional.push(...argv.slice(i + 1));
      break;
    }
    if (arg.startsWith("--")) {
      const eq = arg.indexOf("=");
      if (eq >= 0) {
        args[arg.slice(0, eq)] = arg.slice(eq + 1);
        i++;
      } else if (VALUE_FLAGS.has(arg) && i + 1 < argv.length && argv[i + 1] !== "--") {
        // `--` is a separator, never a flag value; a bare value-flag before
        // `--` (e.g. `a cc --task <slug> --worktree -- --add-dir /x`) must not
        // swallow it.
        args[arg] = argv[i + 1];
        i += 2;
      } else {
        args[arg] = true;
        i++;
      }
    } else {
      positional.push(arg);
      i++;
    }
  }
  args._ = positional;
  return args;
}

/** Print an exit-coded refusal (the message on stderr, and under --json an error object with its code on stdout) and exit; anything else is rethrown. */
function refuse(err, json) {
  if (!Number.isInteger(err.exitCode)) throw err;
  if (json) output(true, { error: err.code || "refused", message: err.message, ...err.detail });
  process.stderr.write(err.message + "\n");
  process.exit(err.exitCode);
}

function resolveSessionId(args) {
  const { validateSessionId } = require("../lib/session");
  if (args["--session-id"]) {
    validateSessionId(args["--session-id"]);
    return args["--session-id"];
  }
  if (process.env.AGENTS_SESSION_ID) {
    validateSessionId(process.env.AGENTS_SESSION_ID);
    const session = require("../lib/session").find({ session_id: process.env.AGENTS_SESSION_ID });
    if (session) return process.env.AGENTS_SESSION_ID;
  }
  return `pid-${process.pid}`;
}

function resolveRepo(args) {
  const repoPath = args["--repo"] || args["--path"] || ".";
  return require("../lib/repo").repoKey(repoPath);
}

/**
 * The repo of a verb that takes a task: `--repo`/`--path` when given, else the main checkout the
 * tasks root's index records for an absolute task dir (refused `not_indexed` when it records none,
 * so a caller's cwd never becomes the checkout), else the cwd's repo.
 */
function repoFor(args, taskDirInput, json) {
  if (args["--repo"] || args["--path"] || !taskDirInput || taskDirInput === true || !path.isAbsolute(taskDirInput)) return resolveRepo(args);
  const { mainRootOf } = require("../lib/tasks-root");
  let real = null;
  try { real = fs.realpathSync(taskDirInput); } catch { /* a missing dir is placed by its path alone */ }
  const mainRoot = mainRootOf(path.resolve(taskDirInput)) || (real && mainRootOf(real));
  if (!mainRoot) {
    refuse(require("../lib/start").fail(2,
      `${taskDirInput} is not in the tasks root's index (no main checkout recorded for it); pass --repo <checkout>`,
      "not_indexed", { task_dir: taskDirInput }), json);
  }
  return require("../lib/repo").repoKey(mainRoot);
}

function resolveTaskDir(input, key) {
  if (!input) return input;
  // D35: move-on-first-touch — if a repo-local .tasks/ exists, move it to the
  // central root before resolving. Self-exclusion via CLAUDE_CODE_SESSION_ID.
  try {
    require("../lib/tasks-root").ensureMigrated(key);
  } catch (err) {
    if (err.refused || err.failClosed) throw err;
    // Other errors are non-fatal — proceed with central path
  }
  if (path.isAbsolute(input)) return input;
  // D35: tasks live at the central root, not repo-local .tasks/.
  // A numeric or slug input resolves through tasksRoot().
  const { tasksRoot } = require("../lib/tasks-root");
  const root = tasksRoot(key);
  if (/^\d+$/.test(input)) {
    if (fs.existsSync(root)) {
      const padded = input.padStart(3, "0");
      const match = fs.readdirSync(root).find((n) => n.startsWith(padded + "-"));
      if (match) return path.join(root, match);
    }
  }
  // Try matching a slug in the central root
  if (fs.existsSync(root)) {
    const match = fs.readdirSync(root).find((n) => n.endsWith("-" + input) || n === input);
    if (match) return path.join(root, match);
  }
  return path.join(root, input);
}

function getArg(args, ...names) {
  for (const n of names) {
    if (args[n] !== undefined && args[n] !== true) return args[n];
  }
  return undefined;
}

function output(json, value) {
  if (json) {
    console.log(JSON.stringify(value, null, 2));
  } else if (typeof value === "string") {
    console.log(value);
  } else {
    console.log(JSON.stringify(value, null, 2));
  }
}

// `a hook <name>`: the shell stubs call this. A crash must never turn into a
// block (a non-zero exit can stop a prompt), so every failure exits 0. Only the
// two registered hooks are loadable; any other name exits 0 and loads nothing.
const HOOK_NAMES = ["session-register", "session-end"];

function runHookMode(name) {
  try {
    if (!HOOK_NAMES.includes(name)) process.exit(0);
    if (require("../lib/hooks/common").hooksDisabled()) process.exit(0);
    const db = require("../lib/db");
    if (db.enabled() && !db.nodeSqliteOk()) {
      process.stderr.write(`agents: node ${process.version} at ${process.execPath} has no node:sqlite; hook ${name} skipped (run ./install.sh)\n`);
      process.exit(0);
    }
    let stdinData = "";
    try { stdinData = fs.readFileSync("/dev/stdin", "utf8"); } catch {}
    let hookInput = {};
    try { hookInput = stdinData ? JSON.parse(stdinData) : {}; } catch {}
    const output = require(`../lib/hooks/${name}`).run(hookInput);
    if (output) console.log(JSON.stringify(output));
    process.exit(0);
  } catch (err) {
    process.stderr.write(`agents: hook ${name} failed: ${err.message}\n`);
    process.exit(0);
  }
}

/** Every value of a flag given more than once, as `--flag=v` or `--flag v`. */
function repeatedFlag(argv, flag) {
  const out = [];
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === flag && i + 1 < argv.length) out.push(argv[++i]);
    else if (argv[i].startsWith(`${flag}=`)) out.push(argv[i].slice(flag.length + 1));
  }
  return out;
}

const NO_SUBCMD_GROUPS = new Set(["policy", "launch", "next", "land", "doctor", "export", "ls", "start", "attach", "resume", "decide"]);

// The three session verbs parse their own arguments and return { exitCode, json, text }.
function runSessionVerb(verb, rest) {
  const startLib = require("../lib/start");
  let result;
  try {
    result = startLib[verb](startLib.parseArgs(rest, verb));
  } catch (err) {
    if (rest.includes("--json")) output(true, { error: err.code || "refused", message: err.message, ...err.detail });
    process.stderr.write(err.message + "\n");
    process.exit(Number.isInteger(err.exitCode) ? err.exitCode : 2);
  }
  if (result.json) output(true, result.json);
  else if (result.text) console.log(result.text);
  process.exit(result.exitCode);
}
const CC_SUBCMDS = new Set(["ls", "attach", "kill"]);

function main() {
  const argv = process.argv.slice(2);
  if (argv.length > 0 && VERB_ALIASES[argv[0]]) argv[0] = VERB_ALIASES[argv[0]];
  const group = argv[0] || "";
  // A subcommand is a bare token; a flag (starts with "--") or nothing in the
  // second position means the group takes flags directly (e.g. `a cc --task`).
  const hasSubCmd = argv[1] !== undefined && !argv[1].startsWith("--");
  let cmd, rest;
  if (NO_SUBCMD_GROUPS.has(group) || !hasSubCmd) {
    cmd = "";
    rest = argv.slice(1);
  } else if (group === "cc" && !CC_SUBCMDS.has(argv[1])) {
    // `a cc courier`, `a cc <slug>` — not a real subcommand; treat as bare cc.
    cmd = "";
    rest = argv.slice(1);
  } else {
    cmd = argv[1] || "";
    rest = argv.slice(2);
  }

  // --help/-h short-circuit: print usage and exit 0 before any argument
  // validation or side effect. Scans the raw argv so `--help` wins even when
  // other valid flags are present (e.g. `a task set --task-dir <dir> --help`).
  if (argv.some((a) => a === "--help" || a === "-h")) {
    const helpGroup = (group === "--help" || group === "-h") ? "" : group;
    const helpCmd = (cmd === "--help" || cmd === "-h") ? "" : cmd;
    printHelp(helpGroup, helpCmd, argv.includes("--all"));
    process.exit(0);
  }

  if (group === "hook") runHookMode(cmd);
  if (group === "start" || group === "attach" || group === "resume") runSessionVerb(group, argv.slice(1));

  // Short flags become long names before the generic parser sees them.
  const shorts = shortsFor(`${group} ${cmd}`.trim());
  if (shorts) {
    try {
      rest = expandShort(rest, shorts, VALUE_FLAGS, `${group} ${cmd}`.trim());
    } catch (err) {
      process.stderr.write(err.message + "\n");
      process.exit(2);
    }
  }
  const args = parseArgs(rest);
  const json = args["--json"] === true;

  let sessionId;
  try {
    sessionId = resolveSessionId(args);

    switch (`${group} ${cmd}`.trim()) {
      case "ls": {
        const rosterLib = require("../lib/roster");
        const input = args._.length > 0 ? args._[0] : null;
        if (args._.length > 1) throw argError(`ls takes one task, got: ${args._.join(" ")}`);
        const explicitRepo = getArg(args, "--repo", "--path");
        if (input) {
          const key = resolveRepo(args);
          const found = require("../lib/start").resolveTask(input, key);
          const row = found && rosterLib.build({ repoKey: key.key, all: true }).tasks.find((t) => path.resolve(t.dir) === path.resolve(found.dir));
          if (!row) throw notFoundError(`No active task ${input} in ${key.key}`);
          const doc = JSON.parse(fs.readFileSync(path.join(row.dir, "task.json"), "utf8"));
          if (json) output(true, { ...row, task: doc });
          else console.log(rosterLib.formatTask(row, doc));
          break;
        }
        const data = rosterLib.build({ all: args["--all"] === true, ...(explicitRepo ? { repoKey: resolveRepo(args).key } : {}) });
        if (json) output(true, data);
        else console.log(rosterLib.formatText(data));
        break;
      }

      case "repo key": {
        const key = resolveRepo(args);
        output(json, key);
        break;
      }

      case "tasks root": {
        const key = resolveRepo(args);
        const root = require("../lib/tasks-root").tasksRoot(key);
        output(json, { root });
        break;
      }

      case "task new":
      case "task create": {
        const title = getArg(args, "--title");
        if (!title) throw argError("--title is required");
        const slug = getArg(args, "--slug") || slugify(title);
        const mode = getArg(args, "--mode");
        const tier = getArg(args, "--tier");
        const description = getArg(args, "--description") || "";
        const phasesJson = getArg(args, "--phases-json");
        const phases = phasesJson ? JSON.parse(phasesJson) : [];
        const key = resolveRepo(args);
        const result = require("../lib/task").createTask({
          repo: key, title, slug, mode, tier, phases, description, session_id: sessionId,
        });
        output(json, result);
        break;
      }

      case "task read": {
        const taskDirInput = getArg(args, "--task-dir") || (args._.length > 0 ? args._[0] : null);
        if (!taskDirInput) throw argError("--task-dir or positional arg required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const task = require("../lib/task").loadTask(taskDirAbs);
        output(json, task);
        break;
      }

      case "task check": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const phaseId = Number(getArg(args, "--phase-id"));
        if (!Number.isInteger(phaseId)) throw argError("--phase-id is required (an integer)");
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        let result;
        try { result = require("../lib/task").checkPhase({ taskDir: taskDirAbs, phaseId }); } catch (err) { refuse(err, json); }
        output(json, result);
        break;
      }

      case "task add-phases": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const raw = getArg(args, "--phases-json");
        if (!raw) throw argError("--phases-json is required: [{id, name, after}]");
        let phases;
        try { phases = JSON.parse(raw); } catch (err) { throw argError(`--phases-json is not JSON: ${err.message}`); }
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        let result;
        try { result = require("../lib/task").addPhases({ taskDir: taskDirAbs, phases }); } catch (err) { refuse(err, json); }
        output(json, result);
        break;
      }

      case "policy": {
        const policy = require("../lib/policy").resolvePolicy(
          args["--path"] || args["--repo"] || "."
        );
        output(json, policy);
        break;
      }

      case "session register": {
        const sessionLib = require("../lib/session");
        const sid = getArg(args, "--session-id");
        if (!sid) throw argError("--session-id is required");
        const key = resolveRepo(args);
        const taskDirRaw = getArg(args, "--task-dir");
        const taskDir = taskDirRaw ? resolveTaskDir(taskDirRaw, key) : null;
        const result = sessionLib.register({
          session_id: sid,
          pid: getArg(args, "--pid") ? parseInt(getArg(args, "--pid"), 10) : process.ppid,
          terminal_id: getArg(args, "--terminal-id"),
          session_dir: getArg(args, "--session-dir"),
          origin: getArg(args, "--origin"),
          cwd: getArg(args, "--cwd") || process.cwd(),
          agent: getArg(args, "--agent"),
          repo_key: getArg(args, "--repo-key") || key.key,
          task_dir: taskDir,
          initiator: getArg(args, "--initiator"),
          workflow_id: getArg(args, "--workflow-id") ? parseInt(getArg(args, "--workflow-id"), 10) : undefined,
          commitment_id: getArg(args, "--commitment-id"),
          project_id: getArg(args, "--project-id"),
          transcript_path: getArg(args, "--transcript-path"),
          source: getArg(args, "--source"),
          previous_session_id: getArg(args, "--previous-session-id"),
          tmux: (getArg(args, "--tmux-server") || getArg(args, "--tmux-session"))
            ? { server: getArg(args, "--tmux-server") || "pav", session: getArg(args, "--tmux-session") || null }
            : undefined,
        });
        output(json, result);
        break;
      }

      case "session unregister": {
        const sessionLib = require("../lib/session");
        const sid = getArg(args, "--session-id");
        if (!sid) throw argError("--session-id is required");
        const ok = sessionLib.unregister(sid);
        output(json, { unregistered: ok });
        break;
      }

      case "session touch": {
        const sessionLib = require("../lib/session");
        const sid = getArg(args, "--session-id");
        if (!sid) throw argError("--session-id is required");
        const ok = sessionLib.touch(sid);
        output(json, { touched: ok });
        break;
      }

      case "session ls": {
        const sessionLib = require("../lib/session");
        const prune = args["--prune"] === true;
        if (prune) {
          const result = sessionLib.pruneLostSessions();
          output(json, result);
          break;
        }
        const sessions = sessionLib.list();
        if (json) {
          output(true, sessions);
        } else {
          for (const s of sessions) {
            const status = s.ended_at ? "exited" : (sessionLib.isLive(s) ? "live" : "lost");
            console.log(`${s.session_id}\t${s.agent || "-"}\t${status}\t${s.cwd || "-"}\t${s.task_dir || "-"}`);
          }
        }
        break;
      }

      case "launch": {
        const agent = getArg(args, "--agent");
        const cwd = getArg(args, "--cwd");
        const worktree = getArg(args, "--worktree");
        // claude --session-id requires a UUID. resolveSessionId falls back to
        // pid-<pid> for state-mutation identity, which claude rejects, so mint
        // a UUID when none was given. (cc already mints one and passes it
        // explicitly; this covers direct `a launch` invocations.)
        const sid = getArg(args, "--session-id") || require("../lib/session").mintId();
        const launchArgs = args._ || [];
        require("../lib/launch").launch({ agent, sessionId: sid, cwd, worktree, args: launchArgs });
        break;
      }

      case "cc": {
        const ccLib = require("../lib/cc");
        // parseCcArgs handles flags before positionals (D39), "courier" as
        // shorthand for --agent Courier, and `--` passthrough.
        const ccOpts = ccLib.parseCcArgs(rest);
        ccOpts.json = json;
        // If positionals were collected and no explicit prompt, join as prompt.
        if (ccOpts.positionals && ccOpts.positionals.length > 0 && !ccOpts.prompt) {
          ccOpts.prompt = ccOpts.positionals.join(" ");
        }
        try {
          ccLib.launch(ccOpts);
        } catch (err) {
          if (json) console.log(JSON.stringify({ error: "launch", message: err.message }));
          else process.stderr.write(err.message + "\n");
          process.exit(2);
        }
        break;
      }

      case "cc ls": {
        const sessionLib = require("../lib/session");
        const ccLib = require("../lib/cc");
        const all = args["--all"] === true;
        let sessions = sessionLib.list();
        // Default: live sessions only; --all for history (D38 item 6).
        if (!all) {
          sessions = sessions.filter((s) => sessionLib.isLive(s));
        }
        // Join zmx list for mux status (D44).
        let zmxSessions = [];
        if (ccLib.zmxAvailable()) {
          zmxSessions = ccLib.zmxList();
          // Mark entries whose zmx session is gone as exited. `zmx list`
          // lines carry more than the name, so compare parsed names.
          const running = require("../lib/start").zmxSessions();
          if (running) {
            const names = running.filter((z) => !z.ended).map((z) => z.name);
            sessions = sessions.map((s) => {
              if (s.mux && s.mux.kind === "zmx" && !names.includes(s.mux.name) && !s.ended_at) {
                s.ended_at = new Date().toISOString();
              }
              return s;
            });
          }
        }
        if (json) {
          // Additive: keep tmux_sessions (contract) and add zmx_sessions (D44).
          let tmuxSessions = [];
          try {
            const { execSync } = require("child_process");
            const out = execSync("tmux -L pav ls 2>/dev/null", { encoding: "utf8", timeout: 2000, stdio: ["pipe", "pipe", "pipe"] });
            tmuxSessions = out.trim().split("\n").filter(Boolean);
          } catch {}
          output(true, { sessions, tmux_sessions: tmuxSessions, zmx_sessions: zmxSessions });
        } else {
          for (const s of sessions) {
            const status = s.ended_at ? "exited" : (sessionLib.isLive(s) ? "live" : "lost");
            const task = s.task_dir ? path.basename(s.task_dir) : "-";
            console.log(`${s.terminal_id || s.session_id}\t${s.agent || "-"}\t${status}\t${task}\t${s.cwd || "-"}`);
          }
        }
        break;
      }

      case "cc attach": {
        const sessionLib = require("../lib/session");
        const { execSync } = require("child_process");
        const target = args._.length > 0 ? args._[0] : null;
        if (!target) throw argError("cc attach requires <id|slug>");
        const sessions = sessionLib.list();
        const found = sessions.find((s) =>
          s.terminal_id === target || s.session_id === target ||
          (s.task_dir && path.basename(s.task_dir) === target)
        );
        if (!found) throw notFoundError(`No session matching ${target}`);
        // D44: zmx attach if mux.kind is zmx; tmux attach otherwise.
        if (found.mux && found.mux.kind === "zmx") {
          try { execSync(`zmx attach ${found.mux.name}`, { stdio: "inherit" }); } catch {}
        } else {
          const tmuxSession = found.tmux && found.tmux.session ? found.tmux.session : `pav-t-${found.terminal_id || found.session_id}`;
          try { execSync(`tmux -L pav attach -t ${tmuxSession}`, { stdio: "inherit" }); } catch {}
        }
        break;
      }

      case "cc kill": {
        const sessionLib = require("../lib/session");
        const { execSync, execFileSync } = require("child_process");
        const target = args._.length > 0 ? args._[0] : null;
        if (!target) throw argError("cc kill requires <id>");
        const sessions = sessionLib.list();
        const found = sessions.find((s) =>
          s.terminal_id === target || s.session_id === target
        );
        if (!found) throw notFoundError(`No session matching ${target}`);
        // D44: zmx kill if mux.kind is zmx; tmux kill otherwise.
        if (found.mux && found.mux.kind === "zmx") {
          try { execFileSync("zmx", ["kill", found.mux.name], { stdio: ["pipe", "pipe", "pipe"], timeout: 2000 }); } catch {}
        } else {
          const tmuxSession = found.tmux && found.tmux.session ? found.tmux.session : `pav-t-${found.terminal_id || found.session_id}`;
          try { execSync(`tmux -L pav kill-session -t ${tmuxSession}`, { stdio: "pipe" }); } catch {}
        }
        sessionLib.unregister(found.session_id);
        output(json, { killed: target, session: found.session_id });
        break;
      }

      case "task set": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const knob = getArg(args, "--knob");
        if (!knob) throw argError("--knob is required (approvals, land)");
        const value = getArg(args, "--value");
        if (value === undefined) throw argError("--value is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        let result;
        try { result = require("../lib/task").setKnob({ taskDir, knob, value }); } catch (err) { refuse(err, json); }
        output(json, result);
        break;
      }

      case "task import": {
        const r = require("../lib/db-import").importAll({ apply: args["--apply"] === true });
        if (json) console.log(JSON.stringify(r, null, 2));
        else printImport(r);
        if (r.refused) process.exit(1);
        break;
      }

      case "export": {
        const exportLib = require("../lib/db-export");
        const outDir = getArg(args, "--out");
        if (args["--check"] === true) {
          const r = exportLib.check();
          if (json) console.log(JSON.stringify(r, null, 2));
          else if (r.equal) console.log("exports equal the files");
          else for (const d of r.diffs) console.log(`${d.kind}: ${d.path}`);
          if (!r.equal) process.exit(1);
        } else if (outDir) {
          output(json, exportLib.renderExports(path.resolve(outDir), { source: "db" }));
        } else {
          output(json, exportLib.exportInPlace());
        }
        break;
      }

      case "task close": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const result = require("../lib/task").closeTask({ taskDir, repoKeyObj: key });
        output(json, result);
        if (!json && result.worktree) process.stderr.write(require("../lib/worktree").reapLine(result.worktree) + "\n");
        break;
      }

      case "tasks sweep": {
        const key = resolveRepo(args);
        const apply = args["--apply"] === true;
        const olderThan = getArg(args, "--older-than");
        const olderThanDays = olderThan ? parseInt(olderThan.replace(/d$/, ""), 10) : undefined;
        const result = require("../lib/tasks-sweep").sweep({ repoKeyObj: key, apply, olderThanDays });
        output(json, result);
        break;
      }

      case "tasks backup": {
        const { initBackup, runBackup } = require("../lib/backup");
        const root = require("../lib/tasks-root").tasksRootBase();
        if (args["--init"] === true) {
          initBackup(root);
          output(json, { init: true, root, committed: true });
        } else {
          const result = runBackup(root);
          const dbLib = require("../lib/db");
          if (dbLib.enabled()) result.db_backup = dbLib.backup({ maxAgeHours: 24 });
          output(json, result);
        }
        break;
      }

      case "tasks doctrine": {
        const key = resolveRepo(args);
        const doctrineJson = args._.length > 0 ? args._[0] : null;
        if (!doctrineJson) throw argError("doctrine JSON is required (e.g. '{\"default\":\"standard\",\"courier\":\"minor\"}')");
        const defaultTiers = JSON.parse(doctrineJson);
        const { updateRootIndex } = require("../lib/tasks-root");
        const result = updateRootIndex(key.key, { default_tiers: defaultTiers });
        output(json, result);
        break;
      }

      case "trash ls": {
        const olderThan = getArg(args, "--older-than");
        let olderThanDays;
        if (olderThan) {
          olderThanDays = parseInt(olderThan.replace(/d$/, ""), 10);
          if (Number.isNaN(olderThanDays)) throw argError(`--older-than must parse to a number of days, got: ${olderThan}`);
        }
        const result = require("../lib/trash").listTrash({ olderThanDays });
        output(json, result);
        break;
      }

      case "trash purge": {
        const olderThan = getArg(args, "--older-than");
        if (!olderThan) throw argError("--older-than <Nd> is required for purge");
        const olderThanDays = parseInt(olderThan.replace(/d$/, ""), 10);
        if (Number.isNaN(olderThanDays)) throw argError(`--older-than must parse to a number of days, got: ${olderThan}`);
        const result = require("../lib/trash").purgeTrash({ olderThanDays });
        output(json, result);
        break;
      }

      case "next": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const task = require("../lib/task").loadTask(taskDirAbs);
        const advice = require("../lib/advise").adviceFor(taskDirAbs, task, { mainRoot: key.main_root });
        const db = require("../lib/db");
        const taskId = db.enabled() ? db.taskIdOf(taskDirAbs) : null;
        const decisions = taskId === null ? [] : db.listDecisions({ taskId }).slice(-20)
          .map((d) => ({ phase_id: d.phase_id, choice: d.choice, quote: d.quote, decided_at: d.decided_at }));
        const notes = (task.phases || []).filter((p) => p.note).map((p) => ({ phase_id: p.id, note: p.note }));
        if (json) {
          output(true, { task_dir: taskDirAbs, title: task.title, advice, decisions, notes, worktree: advice.worktree });
          break;
        }
        const lines = [
          `Phase: ${advice.phase ? `${advice.phase.id} ${advice.phase.name}` : "-"}`,
          `Next: ${advice.advice}`,
        ];
        if (advice.question) lines.push(`Question: ${advice.question.text} [${advice.question.choices.join(" | ")}]`);
        for (const w of advice.warnings) lines.push(`Warning: ${w}`);
        lines.push(`Worktree: ${advice.worktree || "-"}`, `Task dir: ${taskDirAbs}`);
        console.log(lines.join("\n"));
        break;
      }

      case "decide":
      case "task note": {
        const key = repoFor(args, getArg(args, "--task-dir"), json);
        const taskDirOf = (input) => {
          const dir = resolveTaskDir(input, key);
          return path.isAbsolute(dir) ? dir : path.resolve(key.main_root, dir);
        };
        let result;
        try {
          result = require("../lib/decide").cli(cmd || group, args, { taskDirOf });
        } catch (err) {
          refuse(err, json);
        }
        if (json) output(true, result.json);
        else if (result.text) console.log(result.text);
        break;
      }

      case "plan lint": {
        const file = getArg(args, "--file");
        if (!file) throw argError("--file is required");
        const lint = require("../lib/lint");
        const key = resolveRepo(args);
        const filePath = path.isAbsolute(file) ? file : path.resolve(key.main_root, file);
        let result;
        if (require("../lib/task").isTaskMd(file)) {
          result = lint.lintTaskMd(filePath);
        } else {
          result = lint.lintPlan(filePath);
          const crossTask = lint.checkCrossTaskManifestOverlap(filePath, key.main_root);
          if (!crossTask.ok) {
            result.warnings = result.warnings || [];
            for (const o of crossTask.overlaps) {
              result.warnings.push(`cross-task overlap with ${o.task}: ${o.files.join(", ")}`);
            }
          }
        }
        output(json, result);
        if (!result.ok) process.exit(2);
        break;
      }

      case "worktree add": {
        const key = resolveRepo(args);
        const taskDirInput = getArg(args, "--task");
        const name = getArg(args, "--name");
        const force = args["--force"] === true;
        const printPath = args["--print-path"] === true;
        const result = require("../lib/worktree").add({
          projectDir: key.main_root,
          taskDir: taskDirInput,
          name,
          force,
        });
        if (printPath) {
          console.error(`Worktree created at ${result.path} on branch ${result.branch}.`);
          console.log(result.path);
        } else {
          output(json, result);
        }
        break;
      }

      case "worktree remove": {
        const key = resolveRepo(args);
        const wtPath = args._.length > 0 ? args._[0] : null;
        if (!wtPath) throw argError("worktree remove requires <path>");
        const force = args["--force"] === true;
        const result = require("../lib/worktree").remove({
          projectDir: key.main_root, path: wtPath, force,
        });
        output(json, result);
        break;
      }

      case "worktree list": {
        const key = resolveRepo(args);
        const result = require("../lib/worktree").list(key.main_root);
        if (json) {
          output(true, result);
        } else {
          for (const wt of result) {
            console.log(`${wt.path}\t${wt.branch || "(detached)"}\t${wt.isMain ? "main" : "worktree"}`);
          }
        }
        break;
      }

      case "worktree clean": {
        const key = resolveRepo(args);
        const dryRun = args["--dry-run"] === true;
        const result = require("../lib/worktree").clean({
          projectDir: key.main_root, dryRun,
        });
        output(json, result);
        break;
      }

      case "land": {
        const taskDirInput = getArg(args, "--task-dir") || getArg(args, "--task");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const policy = getArg(args, "--policy");
        let result;
        try {
          result = require("../lib/land").land({ taskDir: taskDirAbs, projectDir: key.main_root, checks: repeatedFlag(rest, "--check"), policy });
        } catch (err) {
          refuse(err, json);
        }
        if (json) output(true, result);
        else console.log(result.pr_url ? `Landed ${result.branch} as ${result.pr_url}` : `Landed ${result.branch || result.base} on ${result.base}`);
        break;
      }

      case "doctor": {
        // Hook-wiring + permissions check (the full `a doctor` is A10).
        // Verifies every AGENTS hook is registered in ~/.claude/settings.json,
        // that each hook script resolves `a`, that the central tasks root
        // is in permissions.additionalDirectories (D25), and which `a` the
        // hook stubs run (the installed snapshot, or the checkout fallback).
        // `a doctor hooks [off|on]` flips or shows the kill switch instead.
        if (args._[0] === "hooks") {
          const flag = require("../lib/hooks/common").hooksDisabledPath();
          const sub = args._[1];
          if (args._.length > 2 || (sub !== undefined && sub !== "off" && sub !== "on")) {
            process.stderr.write("usage: a doctor hooks [off|on]\n");
            process.exit(2);
          }
          if (sub === "off" && !fs.existsSync(flag)) {
            fs.mkdirSync(path.dirname(flag), { recursive: true });
            fs.writeFileSync(flag, new Date().toISOString() + "\n");
          } else if (sub === "on") {
            try {
              fs.unlinkSync(flag);
            } catch (err) {
              if (err.code === "EPERM" || err.code === "EACCES") {
                process.stderr.write(`cannot remove ${flag} (immutable? run: chflags nouchg ${flag})\n`);
                process.exit(1);
              }
              if (err.code !== "ENOENT") throw err;
            }
          }
          const off = fs.existsSync(flag);
          if (json) output(json, { hooks: off ? "off" : "on", flag });
          else console.log(`hooks ${off ? "OFF" : "ON"} (${flag})`);
          break;
        }
        const os = require("os");
        const stubA = require("../install-snapshot").resolveStubA(os.homedir());
        if (!json) process.stderr.write(`a (hook stubs): ${stubA.path || "(none)"} (via ${stubA.via})\n`);
        const dbInfo = require("../lib/db").describe();
        if (!json) printDbDoctor(dbInfo);
        const installer = require("../install-global-hooks");
        const settings = installer.readSettings();
        const issues = [];
        let hooksRegistered = 0;
        for (const [event, entries] of Object.entries(installer.AGENTS_HOOKS)) {
          for (const entry of entries) {
            const script = entry.hooks[0].command.split("/").pop();
            const present = (settings.hooks && settings.hooks[event] || []).some(
              (e) => e.hooks && e.hooks.some((h) => h.command && h.command.includes(script))
            );
            if (present) hooksRegistered++;
            else issues.push(`${event}/${script}: not registered in ~/.claude/settings.json`);
            const local = path.join(__dirname, "..", "..", "hooks", script);
            if (!fs.existsSync(local)) issues.push(`${script}: missing in hooks/`);
          }
        }
        if (!installer.isAdditionalDirPresent(settings)) {
          issues.push("permissions.additionalDirectories: missing ~/.agents/tasks (run ./install.sh)");
        }
        const aLink = path.join(os.homedir(), ".local", "bin", "a");
        if (!fs.existsSync(aLink)) issues.push("~/.local/bin/a: missing (run ./install.sh)");
        if (stubA.via === "checkout") issues.push("hook stubs fall back to the checkout; run ./install.sh");
        if (stubA.via === "none") issues.push("no installed a in ~/.agents/bin; run ./install.sh");
        const nodeLink = path.join(os.homedir(), ".agents", "bin", "node");
        const nodeInfo = { path: null, sqlite: null };
        try {
          nodeInfo.path = fs.realpathSync(nodeLink);
          nodeInfo.sqlite = require("child_process").spawnSync(nodeLink, ["-e", 'require("node:sqlite")'], { stdio: "ignore" }).status === 0;
          if (!nodeInfo.sqlite) issues.push(`${nodeLink} cannot load node:sqlite; hooks skip while the database is on`);
        } catch {
          issues.push("recorded node missing: ~/.agents/bin/node (run ./install.sh)");
        }
        if (!json) process.stderr.write(`node (hook stubs): ${nodeInfo.path || "(none)"}\n`);
        let hookCount = 0;
        for (const entries of Object.values(installer.AGENTS_HOOKS)) hookCount += entries.length;
        // D44: check zmx is installed and at least version 0.8.1.
        const ccLib = require("../lib/cc");
        if (!ccLib.zmxAvailable()) {
          issues.push("zmx not installed (brew install neurosnap/tap/zmx); sessions will run in foreground or tmux (--tmux)");
        } else if (!ccLib.zmxVersionOk()) {
          issues.push("zmx version < 0.8.1; releases ≤ 0.8.1 replay only part of the scrollback on reattach");
        }
        // Count today's five-field outcome lines; other lines are ignored.
        const hookLogPath = require("../lib/hooks/common").hookLogPath();
        const hookOutcomes = { recorded: 0, not_recorded: 0, error: 0 };
        if (fs.existsSync(hookLogPath)) {
          const today = new Date().toISOString().slice(0, 10);
          const logLines = fs.readFileSync(hookLogPath, "utf8").split("\n").filter(Boolean);
          for (const line of logLines) {
            const parts = line.split("\t");
            if (parts.length < 5 || !parts[0].startsWith(today)) continue;
            if (Object.hasOwn(hookOutcomes, parts[3])) hookOutcomes[parts[3]]++;
          }
        }
        if (!json) {
          process.stderr.write(`Hook log: ${hookLogPath}\n`);
          process.stderr.write(`Hook outcomes today: recorded ${hookOutcomes.recorded}, not recorded ${hookOutcomes.not_recorded}, errors ${hookOutcomes.error}\n`);
        }
        const warnings = [];
        const worktreeLib = require("../lib/worktree");
        let worktreeRows = [];
        try {
          worktreeRows = worktreeLib.survey();
        } catch (surveyErr) {
          warnings.push(`cannot survey ${worktreeLib.worktreesRoot()}: ${surveyErr.message}`);
        }
        if (!json) for (const row of worktreeRows) process.stderr.write(`worktree: ${worktreeLib.surveyLine(row)}\n`);
        // D40: trash dir writable
        const { trashRoot } = require("../lib/trash");
        const trashDirPath = trashRoot();
        try {
          fs.mkdirSync(trashDirPath, { recursive: true });
          const testFile = path.join(trashDirPath, ".doctor-write-test");
          fs.writeFileSync(testFile, "x");
          fs.unlinkSync(testFile);
        } catch {
          issues.push("trash dir not writable: " + trashDirPath);
        }
        // D40: last snapshot younger than 24h (warn, not fail)
        const { tasksRootBase } = require("../lib/tasks-root");
        const docRoot = tasksRootBase();
        if (fs.existsSync(path.join(docRoot, ".git"))) {
          try {
            const lastCommitTs = execSync("git log -1 --format=%ci", { cwd: docRoot, stdio: "pipe" }).toString().trim();
            const ageH = (Date.now() - new Date(lastCommitTs).getTime()) / 3600000;
            if (ageH > 24) warnings.push(`last snapshot ${Math.round(ageH)}h old (run: a tasks backup)`);
          } catch {}
        } else {
          warnings.push("central root is not a git repo (run: a tasks backup --init)");
        }
        for (const name of HOOK_NAMES) {
          try {
            require(`../lib/hooks/${name}`);
          } catch (loadErr) {
            issues.push(`hook ${name} failed to load: ${loadErr.message}; hooks fail open; fix it or run \`a doctor hooks off\``);
          }
        }
        // F19: drift detection — compare installed agent files and hook stubs
        // against generated/, ignoring the `model:` frontmatter line.
        const repoRoot = path.resolve(__dirname, "..", "..");
        const installedAgentsDir = path.join(os.homedir(), ".claude", "agents");
        const generatedAgentsDir = path.join(repoRoot, "generated", "claude", "agents");
        if (fs.existsSync(generatedAgentsDir)) {
          for (const name of fs.readdirSync(generatedAgentsDir)) {
            if (!name.endsWith(".md")) continue;
            const installedPath = path.join(installedAgentsDir, name);
            const generatedPath = path.join(generatedAgentsDir, name);
            if (!fs.existsSync(installedPath)) {
              issues.push(`agent file ${name}: missing in ~/.claude/agents/ (run ./install.sh)`);
              continue;
            }
            try {
              const installed = fs.readFileSync(installedPath, "utf8");
              const generated = fs.readFileSync(generatedPath, "utf8");
              // Strip the model: line (the owner's launcher rewrites it)
              const stripModel = (s) => s.replace(/^model:.*$/gm, "");
              if (stripModel(installed) !== stripModel(generated)) {
                issues.push(`agent file ${name}: differs from generated/ (run ./install.sh)`);
              }
            } catch {}
          }
        }
        const installedHooksDir = path.join(os.homedir(), ".claude", "hooks");
        const sourceHooksDir = path.join(repoRoot, "hooks");
        if (fs.existsSync(sourceHooksDir)) {
          for (const name of fs.readdirSync(sourceHooksDir)) {
            if (!name.endsWith(".sh")) continue;
            const installedPath = path.join(installedHooksDir, name);
            const sourcePath = path.join(sourceHooksDir, name);
            if (!fs.existsSync(installedPath)) {
              issues.push(`hook stub ${name}: missing in ~/.claude/hooks/ (run ./install.sh)`);
              continue;
            }
            try {
              const installed = fs.readFileSync(installedPath, "utf8");
              const source = fs.readFileSync(sourcePath, "utf8");
              if (installed !== source) {
                issues.push(`hook stub ${name}: differs from hooks/ (run ./install.sh)`);
              }
            } catch {}
          }
        }
        if (issues.length === 0) {
          const docResult = { ok: true, hooks: hookCount, message: "all hooks registered and resolving", a_resolves_to: stubA.path, a_via: stubA.via, db: dbInfo, node: nodeInfo, hooks_registered: hooksRegistered, hook_outcomes: hookOutcomes, worktrees: worktreeRows };
          if (warnings.length > 0) docResult.warnings = warnings;
          // D51: say loudly when the kill switch is on.
          const hookCommon = require("../lib/hooks/common");
          docResult.hooks = hookCommon.hooksDisabled() ? "off" : "on";
          if (docResult.hooks === "off") process.stderr.write(`\nHOOKS ARE OFF (${hookCommon.hooksDisabledPath()}); re-enable with: a doctor hooks on\n`);
          if (!json && warnings.length > 0) for (const w of warnings) process.stderr.write("WARN: " + w + "\n");
          output(json, docResult);
        } else {
          output(json, { ok: false, issues, a_resolves_to: stubA.path, a_via: stubA.via, db: dbInfo, node: nodeInfo, hooks_registered: hooksRegistered, hook_outcomes: hookOutcomes, worktrees: worktreeRows });
          if (!json) for (const i of issues) process.stderr.write(i + "\n");
          process.exit(1);
        }
        break;
      }

      default:
        process.stderr.write(`Usage: a <verb> [args] [--json]\n`);
        process.stderr.write(`Verbs: ${VERB_LINES.map(([verb]) => verb).join(" ")}\n`);
        process.stderr.write(`\`a --help --all\` lists the machine verbs.\n`);
        process.exit(2);
    }
  } catch (err) {
    if (err.name === "LockHeldError") {
      if (json) console.log(JSON.stringify({ error: "lock_held", holder: err.holder }));
      else process.stderr.write(`Lock held by ${err.holder.session_id} (pid ${err.holder.pid})\n`);
      process.exit(3);
    }
    if (err.notFound) {
      if (json) console.log(JSON.stringify({ error: "not_found", message: err.message }));
      else process.stderr.write(err.message + "\n");
      process.exit(4);
    }
    if (json) console.log(JSON.stringify({ error: "validation", message: err.message }));
    else process.stderr.write(err.message + "\n");
    process.exit(2);
  }
}

function printImport(r) {
  console.log(r.apply ? (r.refused ? "import refused; nothing written" : "import applied") : "dry run; nothing written (--apply loads the database)");
  console.log(`database: ${r.db}`);
  console.log(`${r.repos} repos, ${r.tasks} tasks, ${r.sessions} sessions`);
  for (const [key, n] of Object.entries(r.by_repo)) console.log(`  ${key}: ${n}`);
  for (const s of r.skipped) console.log(`skipped ${s.path}: ${s.reason}`);
  for (const d of r.mismatches) console.log(`mismatch ${d.kind}: ${d.path}`);
  for (const e of r.errors) console.log(`error: ${e}`);
  if (r.trashed_to) console.log(`originals moved to: ${r.trashed_to}`);
}

function printDbDoctor(info) {
  const nodeLine = info.node_ok
    ? `node: ${process.version} (node:sqlite ok)`
    : `node: ${process.version} needs 22.5+ for the database`;
  process.stderr.write(nodeLine + "\n");
  if (!info.path) { process.stderr.write(`db: ${info.error}\n`); return; }
  if (!info.present) {
    process.stderr.write(`db: none at ${info.path} (a task import --apply creates it)\n`);
    return;
  }
  const age = info.backup_age_hours === null ? "no backup yet" : `backup ${Math.floor(info.backup_age_hours)}h old`;
  if (info.error) {
    process.stderr.write(`db: ${info.path} unreadable: ${info.error}\n`);
    return;
  }
  process.stderr.write(`db: ${info.path} — ${info.tasks} tasks, schema v${info.schema_version}, ${age} (move it aside to return to file-only mode)\n`);
}

function argError(msg) {
  const e = new Error(msg);
  e.name = "ArgError";
  return e;
}

function notFoundError(msg) {
  const e = new Error(msg);
  e.notFound = true;
  return e;
}

function slugify(text) {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
}

// Single source of truth for command usage. Drives both `--help` output and
// the Groups line in the usage error so they cannot drift apart.
// Entry: { g: group, c: subcmd|null, d: desc, f: [[flag, required, valueHint, desc]], ex: example }
const COMMANDS = [
  { g: "ls", c: null, d: "List tasks with their next step and live sessions: live, or not done, written in the last 7 days and checkout present; one task with its phases.",
    f: [["<task>", false, "", "number, NNN-slug or slug: show that task"], ["--all", false, "", "every active task: done, stale and gone-checkout ones too"], ["--repo", false, "<path>", "limit to the repo containing <path>"], ["--json", false, "", "roster JSON: { tasks, sessions }"]],
    ex: "a ls --json" },
  { g: "start", c: null, d: "Open a Conductor (default) or Courier session on a task, in zmx; new tasks and worktrees on request.",
    f: [["<task>", false, "", "number, NNN-slug or slug of an open task"], ["--title", false, "<text>", "create a task with this title"], ["--conductor", false, "", "run the Conductor (default)"], ["--courier", false, "", "run the Courier (new tasks are fast and minor)"], ["--worktree", false, "", "use the task's worktree, creating it if needed"], ["--here", false, "", "use the main checkout even when a session runs there"], ["--repo", false, "<path>", "repo containing <path> (default: cwd)"], ["--no-attach", false, "", "start detached"], ["--json", false, "", "print the session as JSON (implies --no-attach)"], ["-- <args>", false, "", "passed on to claude"]],
    ex: "a start 002 --worktree",
    fails: [
      "<flag> needs a value",
      "Unknown flag <flag> for a <verb>",
      "a <verb> takes one <task>, got another: <arg> (quote a multi-word title)",
      "launch.env_file is not a readable file: <path>",
      "Not inside a git repository: <error>",
      "a <resume|attach> needs a task or a session",
      "No session for <input>",
      "Session <id> runs outside zmx (pid <pid>); switch to its terminal",
      "No live session for <target>; resume it with: a resume <target>",
      "zmx run failed: <why>",
      "could not start claude: <error>",
      "give a task or --title, not both",
      'No task <task> in <repo>; create one with --title "<task>"',
      "a start needs a <task> or --title",
      "Cancelled",
      "Task <name> already has a live <agent>; attach with: a attach <id> (or a attach <name> from inside the repo)",
      "Session <id> is already live in <dir>; attach with: a attach <id>",
