// The eight verbs. `a --help` shows the two a person types (human: true); `a --help --all` shows
// all eight, then one `retiring:` line built from RETIRING. Rows are [verb, alias, text, human];
// decide and land are agent- and PAV-facing and keep no alias.
const VERB_LINES = [
  ["start", "s", "Open a Conductor or Courier session on a task", true],
  ["doctor", "d", "Check the install and the hooks", true],
  ["ls", "l", "List tasks, their next step and live sessions", false],
  ["next", "n", "Say what to do next on a task", false],
  ["resume", "r", "Reopen an ended session, or attach when it is live", false],
  ["task", "t", "new | close | read | check | add-phases | set | note", false],
  ["decide", null, "Record the owner's answer on a phase", false],
  ["land", null, "Land the task's branch on base", false],
];
// Hidden from help and still runnable until the phase that deletes each (PAV calls some of them).
// The one list of them: help and the CHANGELOG line print from these pairs.
const RETIRING = [
  { verb: "attach", deletedBy: "phase 31" },
  { verb: "session", deletedBy: "PAV 295 phases 4–5" },
  { verb: "worktree", deletedBy: "PAV 295 phases 4–5" },
  { verb: "cc", deletedBy: "phase 31" },
  { verb: "launch", deletedBy: "PAV 295 phases 4–5" },
  { verb: "repo key", deletedBy: "phase 31" },
  { verb: "tasks", deletedBy: "PAV 295 phases 4–5" },
  { verb: "trash", deletedBy: "phase 31" },
  { verb: "plan lint", deletedBy: "phase 31" },
  { verb: "export", deletedBy: "phase 31" },
  { verb: "task import", deletedBy: "phase 31" },
  { verb: "task create", deletedBy: "PAV 295 phases 4–5" },
  { verb: "policy", deletedBy: "phase 31" },
  { verb: "hook", deletedBy: "phase 31" },
];
const VERB_NAMES = new Set(VERB_LINES.map(([verb]) => verb));
// Null-prototype so `a constructor` is an unknown verb, not Object.prototype.constructor.
const VERB_ALIASES = Object.assign(Object.create(null), { a: "attach" }, Object.fromEntries(VERB_LINES.filter(([, alias]) => alias).map(([verb, alias]) => [alias, verb])));

// Short flags live here and in start.js FLAG_SPECS; help reads them from the same maps.
const GLOBAL_SHORTS = { "-j": "--json", "-r": "--repo" };
const SHORT_FLAGS = {
  ls: { "-a": "--all" },
  next: { "-d": "--task-dir" },
  land: { "-d": "--task-dir", "-c": "--check", "-p": "--policy" },
  "task new": { "-t": "--title", "-s": "--slug", "-m": "--mode", "-T": "--tier", "-D": "--description", "-P": "--phases-json" },
  "task create": { "-t": "--title", "-s": "--slug", "-m": "--mode", "-T": "--tier", "-D": "--description", "-P": "--phases-json" },
  "task import": { "-y": "--apply" },
  "task close": { "-d": "--task-dir" },
  doctor: {},
};

function shortsFor(key) {
  if (key === "start" || key === "attach" || key === "resume") return require("../lib/start").FLAG_SPECS[key].short;
  if (Object.hasOwn(SHORT_FLAGS, key)) return { ...GLOBAL_SHORTS, ...SHORT_FLAGS[key] };
  return null;
}
const RETIRING_KEYS = new Set(RETIRING.map((r) => r.verb));
for (const e of COMMANDS) {
  e.hidden = !VERB_NAMES.has(e.g) || RETIRING_KEYS.has(e.c ? `${e.g} ${e.c}` : e.g);
}

function commandKey(entry) {
  return entry.c ? `${entry.g} ${entry.c}` : entry.g;
}

function groupsLine() {
  const byGroup = new Map();
  for (const e of COMMANDS) {
    if (e.hidden) continue;
    if (!byGroup.has(e.g)) byGroup.set(e.g, { hasBare: e.c === null, cmds: [] });
    if (e.c !== null) byGroup.get(e.g).cmds.push(e.c);
  }
  const parts = [];
  for (const [g, info] of byGroup) {
    if (info.cmds.length === 0) parts.push(g);
    else if (info.hasBare) parts.push(`${g} [${info.cmds.join("|")}]`);
    else parts.push(`${g} ${info.cmds.join("|")}`);
  }
  return "Groups: " + parts.join(", ");
}

function printCommandHelp(entry) {
  const key = commandKey(entry);
  const shorts = shortsFor(key);
  const usageFlags = entry.f.map((f) => f[2] ? `${f[0]} ${f[2]}` : f[0]);
  process.stdout.write(`Usage: a ${key}${usageFlags.length ? " " + usageFlags.join(" ") : ""}\n\n`);
  process.stdout.write(`${entry.d}\n`);
  if (entry.f.length > 0) {
    process.stdout.write("\nFlags:\n");
    const long = {};
    for (const [s, l] of Object.entries(shorts || {})) long[l] = s;
    const anyShort = entry.f.some((f) => long[f[0]]);
    const labels = entry.f.map((f) => {
      let l = f[2] ? `${f[0]} ${f[2]}` : f[0];
      if (f[1]) l += " (required)";
      if (long[f[0]]) l = `${long[f[0]]}, ${l}`;
      else if (anyShort) l = `    ${l}`;
      return l;
    });
    const width = Math.max(...labels.map((l) => l.length));
    for (let i = 0; i < entry.f.length; i++) {
      process.stdout.write(`  ${labels[i].padEnd(width + 4)}${entry.f[i][3]}\n`);
    }
  }
  if (!entry.noGlobal) process.stdout.write(`\nGlobal: ${shorts && shorts["-j"] ? "-j, --json, -r, --repo" : "--json, --repo"} <path>\n`);
  if (entry.fails) process.stdout.write(`\nFailures:\n${entry.fails.map((m) => `  ${m}`).join("\n")}\n`);
  process.stdout.write(`\nExample:\n  ${entry.ex}\n`);
}

function printHelp(group, cmd, all) {
  const verbLine = ([verb, alias, text]) => `  ${(alias ? `${verb}, ${alias}` : verb).padEnd(11)}${text}`;
  if (!group && !all) {
    const lines = VERB_LINES.filter(([, , , human]) => human).map(verbLine);
    process.stdout.write(`Usage: a <verb> [args] [--json]\n\n${lines.join("\n")}\n\n\`a <verb> --help\` for flags; \`a --help --all\` lists the machine verbs.\n`);
    return;
  }
  if (!group) {
    process.stdout.write(`${VERB_LINES.map(verbLine).join("\n")}\nretiring: ${RETIRING.map((r) => r.verb).join(", ")}\n`);
    return;
  }
  const entries = COMMANDS.filter((e) => e.g === group);
  if (entries.length === 0) {
    process.stderr.write(`Unknown group: ${group}\n${groupsLine()}\n`);
    return;
  }
  if (!cmd) {
    const bare = entries.find((e) => e.c === null);
    const subs = entries.filter((e) => e.c !== null);
    if (subs.length > 0) {
      process.stdout.write(`Usage: a ${group}${bare ? " [command]" : " <command>"}\n\n${group[0].toUpperCase()}${group.slice(1)} commands:\n`);
      const visible = entries.filter((e) => !e.hidden);
      for (const e of visible.length > 0 ? visible : entries) {
        const label = e.c || "(default)";
        process.stdout.write(`  ${label.padEnd(16)}${e.d}\n`);
      }
      process.stdout.write(`\nRun \`a ${group} <command> --help\` for command details.\n`);
    } else {
      printCommandHelp(bare);
    }
    return;
  }
  const entry = entries.find((e) => e.c === cmd);
  if (!entry) {
    process.stderr.write(`Unknown ${group} command: ${cmd}\n${groupsLine()}\n`);
    return;
  }
  printCommandHelp(entry);
}

main();
