#!/usr/bin/env node
"use strict";

const path = require("path");
const fs = require("fs");
const { expandShort } = require("../lib/short-flags");

const VALUE_FLAGS = new Set([
  "--repo", "--path", "--cwd", "--agent", "--session-id", "--terminal-id", "--counter",
  "--title", "--slug", "--mode", "--task-dir", "--phase-id",
  "--owner", "--flag-id", "--type", "--message", "--worktree",
  "--pid", "--description", "--phases-json", "--blocked-by", "--parallel-group",
  "--initiator", "--repo-key", "--origin", "--transcript-path", "--source",
  "--previous-session-id", "--workflow-id", "--commitment-id", "--project-id",
  "--tmux-server", "--tmux-session", "--task",
  "--root", "--checkpoint-id", "--chosen", "--question", "--report-json",
  "--knob", "--value", "--file", "--plan-path", "--options-json",
  "--session-dir",
  "--name", "--commits",
  "--tier", "--older-than", "--since", "--status", "--out",
  "--run-id", "--brief", "--seconds", "--model", "--lines",
  "--choice", "--quote", "--text", "--check", "--policy",
  "--confirm-recorded", "--except", "--gate", "--batch",
  "--expect-plan-hash", "--recorded-by", "--timeout",
]);

function parseArgs(argv) {
  const args = {};
  const positional = [];
  let i = 0;
  while (i < argv.length) {
    const arg = argv[i];
    if (arg === "--") {
      positional.push(...argv.slice(i + 1));
      break;
    }
    if (arg.startsWith("--")) {
      const eq = arg.indexOf("=");
      if (eq >= 0) {
        args[arg.slice(0, eq)] = arg.slice(eq + 1);
        i++;
      } else if (VALUE_FLAGS.has(arg) && i + 1 < argv.length && argv[i + 1] !== "--" && !argv[i + 1].startsWith("--")) {
        // `--` and a following flag are separators, never flag values; a bare
        // value-flag before them (e.g. `a cc --task <slug> --worktree --`) must
        // not swallow either.
        args[arg] = argv[i + 1];
        i += 2;
      } else {
        args[arg] = true;
        i++;
      }
    } else {
      positional.push(arg);
      i++;
    }
  }
  args._ = positional;
  return args;
}

/** Print an exit-coded refusal (the message on stderr, and under --json an error object with its code on stdout) and exit; anything else is rethrown. */
function refuse(err, json) {
  if (!Number.isInteger(err.exitCode)) throw err;
  if (json) output(true, { error: err.code || "refused", message: err.message, ...err.detail });
  process.stderr.write(err.message + "\n");
  process.exit(err.exitCode);
}

function resolveSessionId(args) {
  const { validateSessionId } = require("../lib/session");
  if (args["--session-id"]) {
    validateSessionId(args["--session-id"]);
    return args["--session-id"];
  }
  if (process.env.AGENTS_SESSION_ID) {
    validateSessionId(process.env.AGENTS_SESSION_ID);
    const session = require("../lib/session").find({ session_id: process.env.AGENTS_SESSION_ID });
    if (session) return process.env.AGENTS_SESSION_ID;
  }
  return `pid-${process.pid}`;
}

function resolveRepo(args) {
  const repoPath = args["--repo"] || args["--path"] || ".";
  return require("../lib/repo").repoKey(repoPath);
}

/**
 * The repo of a verb that takes a task: `--repo`/`--path` when given, else the main checkout the
 * tasks root's index records for an absolute task dir (refused `not_indexed` when it records none,
 * so a caller's cwd never becomes the checkout), else the cwd's repo.
 */
function repoFor(args, taskDirInput, json) {
  if (args["--repo"] || args["--path"] || !taskDirInput || taskDirInput === true || !path.isAbsolute(taskDirInput)) {
    const key = resolveRepo(args);
    try {
      require("child_process").execFileSync("git", ["-C", key.main_root, "rev-parse", "--is-inside-work-tree"], {
        encoding: "utf8", timeout: 2000, stdio: ["ignore", "pipe", "pipe"],
      });
    } catch {
      throw require("../lib/start").fail(2,
        `${key.main_root} is not inside a git repository\nRemedy: run from the repo, pass --repo <checkout>, or pass the absolute task dir`,
        "not_in_repo",
        { remedy: "run from the repo, pass --repo <checkout>, or pass the absolute task dir" });
    }
    return key;
  }
  const { mainRootOf } = require("../lib/tasks-root");
  let real = null;
  try { real = fs.realpathSync(taskDirInput); } catch { /* a missing dir is placed by its path alone */ }
  const mainRoot = mainRootOf(path.resolve(taskDirInput)) || (real && mainRootOf(real));
  if (!mainRoot) {
    refuse(require("../lib/start").fail(2,
      `${taskDirInput} is not in the tasks root's index (no main checkout recorded for it); pass --repo <checkout>`,
      "not_indexed", { task_dir: taskDirInput }), json);
  }
  return require("../lib/repo").repoKey(mainRoot);
}

function resolveTaskDir(input, key) {
  if (!input) return input;
  if (path.isAbsolute(input)) return input;
  // D35: tasks live at the central root, not repo-local .tasks/.
  // A numeric or slug input resolves through tasksRoot().
  const { tasksRoot } = require("../lib/tasks-root");
  const root = tasksRoot(key);
  if (/^\d+$/.test(input)) {
    if (fs.existsSync(root)) {
      const padded = input.padStart(3, "0");
      const match = fs.readdirSync(root).find((n) => n.startsWith(padded + "-"));
      if (match) return path.join(root, match);
    }
  }
  // Try matching a slug in the central root
  if (fs.existsSync(root)) {
    const match = fs.readdirSync(root).find((n) => n.endsWith("-" + input) || n === input);
    if (match) return path.join(root, match);
  }
  return path.join(root, input);
}

function getArg(args, ...names) {
  for (const n of names) {
    if (args[n] !== undefined && args[n] !== true) return args[n];
  }
  return undefined;
}

function output(json, value) {
  if (json) {
    console.log(JSON.stringify(value, null, 2));
  } else if (typeof value === "string") {
    console.log(value);
  } else {
    console.log(JSON.stringify(value, null, 2));
  }
}

// `a hook <name>`: the shell stubs call this. A crash must never turn into a
// block (a non-zero exit can stop a prompt), so every failure exits 0. Only the
// registered hooks are loadable; any other name exits 0 and loads nothing.
const _adapter = require("../lib/adapter").forHarness();
const HOOK_NAMES = _adapter.hookHandlers;

/** Every value of a flag given more than once, as `--flag=v` or `--flag v`. */
function repeatedFlag(argv, flag) {
  const out = [];
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === flag && i + 1 < argv.length) out.push(argv[++i]);
    else if (argv[i].startsWith(`${flag}=`)) out.push(argv[i].slice(flag.length + 1));
  }
  return out;
}

const NO_SUBCMD_GROUPS = new Set(["policy", "launch", "next", "land", "doctor", "export", "ls", "start", "resume", "decide", "check"]);

// The three session verbs parse their own arguments and return { exitCode, json, text }.
function runSessionVerb(verb, rest) {
  const startLib = require("../lib/start");
  let result;
  try {
    result = startLib[verb](startLib.parseArgs(rest, verb));
  } catch (err) {
    if (rest.includes("--json")) output(true, { error: err.code || "refused", message: err.message, ...err.detail });
    process.stderr.write(err.message + "\n");
    process.exit(Number.isInteger(err.exitCode) ? err.exitCode : 2);
  }
  if (result.json) output(true, result.json);
  else if (result.text) console.log(result.text);
  process.exit(result.exitCode);
}

function main() {
  const argv = process.argv.slice(2);
  if (argv.length > 0 && VERB_ALIASES[argv[0]]) argv[0] = VERB_ALIASES[argv[0]];
  const group = argv[0] || "";
  // A subcommand is a bare token; a flag (starts with "--") or nothing in the
  // second position means the group takes flags directly (e.g. `a cc --task`).
  const hasSubCmd = argv[1] !== undefined && !argv[1].startsWith("--");
  let cmd, rest;
  if (NO_SUBCMD_GROUPS.has(group) || !hasSubCmd) {
    cmd = "";
    rest = argv.slice(1);
  } else {
    cmd = argv[1] || "";
    rest = argv.slice(2);
  }

  // --help/-h short-circuit: print usage and exit 0 before any argument
  // validation or side effect. Scans the raw argv so `--help` wins even when
  // other valid flags are present (e.g. `a task set --task-dir <dir> --help`).
  if (argv.some((a) => a === "--help" || a === "-h")) {
    const helpGroup = (group === "--help" || group === "-h") ? "" : group;
    const helpCmd = (cmd === "--help" || cmd === "-h") ? "" : cmd;
    printHelp(helpGroup, helpCmd, argv.includes("--all"));
    process.exit(0);
  }

  if (group === "start" || group === "resume") runSessionVerb(group, argv.slice(1));

  // Short flags become long names before the generic parser sees them.
  const shorts = shortsFor(`${group} ${cmd}`.trim());
  if (shorts) {
    try {
      rest = expandShort(rest, shorts, VALUE_FLAGS, `${group} ${cmd}`.trim());
    } catch (err) {
      process.stderr.write(err.message + "\n");
      process.exit(2);
    }
  }
  const args = parseArgs(rest);
  const json = args["--json"] === true;

  let sessionId;
  try {
    sessionId = resolveSessionId(args);

    switch (`${group} ${cmd}`.trim()) {
      case "ls": {
        const rosterLib = require("../lib/roster");
        const input = args._.length > 0 ? args._[0] : null;
        if (args._.length > 1) throw argError(`ls takes one task, got: ${args._.join(" ")}`);
        const explicitRepo = getArg(args, "--repo", "--path");
        if (input) {
          // An absolute dir names its own task — the row places it and its
          // repo answers, with no git spawn; a relative name is scoped to
          // the cwd's repo (--repo/--path override it).
          let dir;
          let repoKeyObj = null;
          if (path.isAbsolute(input)) {
            dir = input;
          } else {
            const key = resolveRepo(args);
            const found = require("../lib/start").resolveTask(input, key, { anyDisposition: true });
            if (!found) throw notFoundError(`No active task ${input} in ${key.key}`);
            dir = found.dir;
            repoKeyObj = key;
          }
          const row = rosterLib.taskDetail(dir, { repoKeyObj });
          if (!row) throw notFoundError(`No active task ${input}`);
          if (json) output(true, row);
          else console.log(rosterLib.formatTask(row));
          break;
        }
        const data = rosterLib.build({ all: args["--all"] === true, ...(explicitRepo ? { repoKey: resolveRepo(args).key } : {}) });
        if (json) output(true, data);
        else console.log(rosterLib.formatText(data));
        break;
      }

      case "tasks root": {
        const key = resolveRepo(args);
        const root = require("../lib/tasks-root").tasksRoot(key);
        output(json, { root });
        break;
      }

      case "task new":
      case "task create": {
        const title = getArg(args, "--title");
        if (!title) throw argError("--title is required");
        const slug = getArg(args, "--slug") || slugify(title);
        const mode = getArg(args, "--mode");
        const tier = getArg(args, "--tier");
        const description = getArg(args, "--description") || "";
        const phasesJson = getArg(args, "--phases-json");
        const phases = phasesJson ? JSON.parse(phasesJson) : [];
        const key = resolveRepo(args);
        const result = require("../lib/task").createTask({
          repo: key, title, slug, mode, tier, phases, description, session_id: sessionId,
        });
        output(json, result);
        break;
      }

      case "task read": {
        const taskDirInput = getArg(args, "--task-dir") || (args._.length > 0 ? args._[0] : null);
        if (!taskDirInput) throw argError("--task-dir or positional arg required");
        // An absolute dir names its own task — the row places it and its repo
        // answers, with no git spawn; a relative name resolves through the
        // cwd's repo (--repo/--path override it).
        let taskDirAbs;
        let repoKeyObj = null;
        if (path.isAbsolute(taskDirInput)) {
          taskDirAbs = taskDirInput;
        } else {
          const key = resolveRepo(args);
          const taskDir = resolveTaskDir(taskDirInput, key);
          taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
          repoKeyObj = key;
        }
        const row = require("../lib/roster").taskDetail(taskDirAbs, { repoKeyObj });
        if (!row) {
          const err = new Error(`No task row for ${taskDirAbs}`);
          err.notFound = true;
          throw err;
        }
        output(json, row);
        break;
      }

      case "task check": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const phaseId = Number(getArg(args, "--phase-id"));
        if (!Number.isInteger(phaseId)) throw argError("--phase-id is required (an integer)");
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        let result;
        try { result = require("../lib/task").checkPhase({ taskDir: taskDirAbs, phaseId }); } catch (err) { refuse(err, json); }
        output(json, result);
        break;
      }

      case "task worktree": {
        const taskDirInput = getArg(args, "--task-dir") || getArg(args, "--task");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        let result;
        try { result = require("../lib/worktree").ensureTaskWorktree({ projectDir: key.main_root, taskDir: taskDirAbs }); } catch (err) { refuse(err, json); }
        if (json) output(true, result);
        else console.log(`worktree ${result.state}: ${result.path}${result.env_copies.length > 0 ? ` (env copied: ${result.env_copies.join(", ")})` : ""}`);
        break;
      }

      case "task add-phases": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const raw = getArg(args, "--phases-json");
        if (!raw) throw argError("--phases-json is required: [{id, name, after}]");
        let phases;
        try { phases = JSON.parse(raw); } catch (err) { throw argError(`--phases-json is not JSON: ${err.message}`); }
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        let result;
        try { result = require("../lib/task").addPhases({ taskDir: taskDirAbs, phases }); } catch (err) { refuse(err, json); }
        output(json, result);
        break;
      }

      case "session register": {
        const sessionLib = require("../lib/session");
        const sid = getArg(args, "--session-id");
        if (!sid) throw argError("--session-id is required");
        const key = resolveRepo(args);
        const taskDirRaw = getArg(args, "--task-dir");
        const taskDir = taskDirRaw ? resolveTaskDir(taskDirRaw, key) : null;
        const result = sessionLib.register({
          session_id: sid,
          pid: getArg(args, "--pid") ? parseInt(getArg(args, "--pid"), 10) : process.ppid,
          terminal_id: getArg(args, "--terminal-id"),
          session_dir: getArg(args, "--session-dir"),
          origin: getArg(args, "--origin"),
          cwd: getArg(args, "--cwd") || process.cwd(),
          agent: getArg(args, "--agent"),
          repo_key: getArg(args, "--repo-key") || key.key,
          task_dir: taskDir,
          initiator: getArg(args, "--initiator"),
          workflow_id: getArg(args, "--workflow-id") ? parseInt(getArg(args, "--workflow-id"), 10) : undefined,
          commitment_id: getArg(args, "--commitment-id"),
          project_id: getArg(args, "--project-id"),
          transcript_path: getArg(args, "--transcript-path"),
          source: getArg(args, "--source"),
          previous_session_id: getArg(args, "--previous-session-id"),
          tmux: (getArg(args, "--tmux-server") || getArg(args, "--tmux-session"))
            ? { server: getArg(args, "--tmux-server") || "pav", session: getArg(args, "--tmux-session") || null }
            : undefined,
        });
        output(json, result);
        break;
      }

      case "session unregister": {
        const sessionLib = require("../lib/session");
        const sid = getArg(args, "--session-id");
        if (!sid) throw argError("--session-id is required");
        const ok = sessionLib.unregister(sid);
        output(json, { unregistered: ok });
        break;
      }

      case "session touch": {
        const sessionLib = require("../lib/session");
        const sid = getArg(args, "--session-id");
        if (!sid) throw argError("--session-id is required");
        const ok = sessionLib.touch(sid);
        output(json, { touched: ok });
        break;
      }

      case "session ls": {
        const sessionLib = require("../lib/session");
        const prune = args["--prune"] === true;
        if (prune) {
          const result = sessionLib.pruneLostSessions();
          output(json, result);
          break;
        }
        const sessions = sessionLib.list();
        if (json) {
          output(true, sessions);
        } else {
          for (const s of sessions) {
            const status = s.ended_at ? "exited" : (sessionLib.isLive(s) ? "live" : "lost");
            console.log(`${s.session_id}\t${s.agent || "-"}\t${status}\t${s.cwd || "-"}\t${s.task_dir || "-"}`);
          }
        }
        break;
      }

      case "launch": {
        const agent = getArg(args, "--agent");
        const cwd = getArg(args, "--cwd");
        const worktree = getArg(args, "--worktree");
        const here = args["--here"] === true;
        // The agent's --session-id requires a UUID. resolveSessionId falls back to
        // pid-<pid> for state-mutation identity, which the agent rejects, so mint
        // a UUID when none was given. (cc already mints one and passes it
        // explicitly; this covers direct `a launch` invocations.)
        const sid = getArg(args, "--session-id") || require("../lib/session").mintId();
        const launchArgs = args._ || [];
        require("../lib/launch").launch({ agent, sessionId: sid, cwd, worktree, here, args: launchArgs });
        break;
      }

      case "task set": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const knob = getArg(args, "--knob");
        if (!knob) throw argError("--knob is required (approvals, land)");
        const value = getArg(args, "--value");
        if (value === undefined) throw argError("--value is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        let result;
        try { result = require("../lib/task").setKnob({ taskDir, knob, value }); } catch (err) { refuse(err, json); }
        output(json, result);
        break;
      }

      case "task close": {
        const batch = getArg(args, "--batch");
        if (batch) {
          const result = require("../lib/task").closeBatch({ batch, quote: getArg(args, "--quote") });
          output(json, result);
          if (!json) {
            for (const c of result.not_closed) console.log(`not closed ${c.dir}: ${c.reason}`);
          }
          break;
        }
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required (or --batch <unresolved.json>)");
        // The row places the dir: its repo_key and the repos table's main_root
        // archive it (as the batch close takes them), never the cwd's; a
        // relative name resolves through the cwd's repo (--repo/--path
        // override it), exactly as `a task read` resolves its dir.
        let taskDirAbs;
        if (path.isAbsolute(taskDirInput)) {
          taskDirAbs = taskDirInput;
        } else {
          const key = resolveRepo(args);
          const resolved = resolveTaskDir(taskDirInput, key);
          taskDirAbs = path.isAbsolute(resolved) ? resolved : path.resolve(key.main_root, resolved);
        }
        const row = require("../lib/task").taskRowOf(taskDirAbs);
        if (!row) {
          const err = new Error(`No task row for ${taskDirAbs}`);
          err.notFound = true;
          throw err;
        }
        const repoRow = require("../lib/db").repoOf(row.repo_key);
        const repoKeyObj = { key: row.repo_key, main_root: (repoRow && repoRow.main_root) || null };
        const result = require("../lib/task").closeTask({ taskDir: taskDirAbs, repoKeyObj, delete: args["--delete"] === true });
        output(json, result);
        if (!json && result.worktree) process.stderr.write(require("../lib/worktree").reapLine(result.worktree) + "\n");
        break;
      }

      case "tasks sweep": {
        const key = resolveRepo(args);
        const apply = args["--apply"] === true;
        const olderThan = getArg(args, "--older-than");
        const olderThanDays = olderThan ? parseInt(olderThan.replace(/d$/, ""), 10) : undefined;
        const result = require("../lib/tasks-sweep").sweep({ repoKeyObj: key, apply, olderThanDays });
        output(json, result);
        break;
      }

      case "tasks backup": {
        const { initBackup, runBackup } = require("../lib/backup");
        const root = require("../lib/tasks-root").tasksRootBase();
        if (args["--init"] === true) {
          initBackup(root);
          output(json, { init: true, root, committed: true });
        } else {
          const result = runBackup(root);
          result.db_backup = require("../lib/db").backup({ maxAgeHours: 24 });
          output(json, result);
        }
        break;
      }

      case "tasks doctrine": {
        const key = resolveRepo(args);
        const doctrineJson = args._.length > 0 ? args._[0] : null;
        if (!doctrineJson) throw argError("doctrine JSON is required (e.g. '{\"default\":\"standard\",\"courier\":\"minor\"}')");
        const defaultTiers = JSON.parse(doctrineJson);
        require("../lib/db").upsertRepo(key.key, { default_tiers: defaultTiers });
        output(json, { ok: true });
        break;
      }

      case "next": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const task = require("../lib/task").loadTask(taskDirAbs);
        const advice = require("../lib/advise").adviceFor(taskDirAbs, task, { mainRoot: key.main_root });
        const db = require("../lib/db");
        const taskId = db.taskIdOf(taskDirAbs);
        const decisions = taskId === null ? [] : db.listDecisions({ taskId }).slice(-20)
          .map((d) => ({ phase_id: d.phase_id, choice: d.choice, quote: d.quote, decided_at: d.decided_at }));
        const notes = (taskId === null ? [] : db.listNotes(taskId)).map((n) => ({ phase_id: n.phase_id, note: n.text }));
        if (json) {
          output(true, { task_dir: taskDirAbs, title: task.title, advice, decisions, notes, worktree: advice.worktree });
          break;
        }
        const lines = [
          `Phase: ${advice.phase ? `${advice.phase.id} ${advice.phase.name}` : "-"}`,
          `Next: ${advice.advice}`,
        ];
        if (advice.question) lines.push(`Question: ${advice.question.text} [${advice.question.choices.join(" | ")}]`);
        for (const w of advice.warnings) lines.push(`Warning: ${w}`);
        lines.push(`Worktree: ${advice.worktree || "-"}`, `Setup: ${advice.setup ? advice.setup.state + (advice.setup.pane ? ` (${advice.setup.pane})` : "") : "-"}`, `Task dir: ${taskDirAbs}`);
        console.log(lines.join("\n"));
        break;
      }

      case "decide":
      case "task note": {
        const key = repoFor(args, getArg(args, "--task-dir"), json);
        const taskDirOf = (input) => {
          const dir = resolveTaskDir(input, key);
          return path.isAbsolute(dir) ? dir : path.resolve(key.main_root, dir);
        };
        let result;
        try {
          result = require("../lib/decide").cli(cmd || group, args, { taskDirOf });
        } catch (err) {
          refuse(err, json);
        }
        if (json) output(true, result.json);
        else if (result.text) console.log(result.text);
        break;
      }

      case "worktree remove": {
        const key = resolveRepo(args);
        const wtPath = args._.length > 0 ? args._[0] : null;
        if (!wtPath) throw argError("worktree remove requires <path>");
        const force = args["--force"] === true;
        const result = require("../lib/worktree").remove({
          projectDir: key.main_root, path: wtPath, force,
        });
        output(json, result);
        break;
      }

      case "worktree list": {
        const key = resolveRepo(args);
        const result = require("../lib/worktree").list(key.main_root);
        if (json) {
          output(true, result);
        } else {
          for (const wt of result) {
            console.log(`${wt.path}\t${wt.branch || "(detached)"}\t${wt.isMain ? "main" : "worktree"}`);
          }
        }
        break;
      }

      case "land": {
        const taskDirInput = getArg(args, "--task-dir") || getArg(args, "--task");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const policy = getArg(args, "--policy");
        let result;
        try {
          result = require("../lib/land").land({ taskDir: taskDirAbs, projectDir: key.main_root, checks: repeatedFlag(rest, "--check"), policy });
        } catch (err) {
          refuse(err, json);
        }
        if (json) output(true, result);
        else console.log(result.pr_url ? `Landed ${result.branch} as ${result.pr_url}` : `Landed ${result.branch || result.base} on ${result.base}`);
        break;
      }

      case "check": {
        const taskDirInput = getArg(args, "--task-dir") || getArg(args, "--task");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = repoFor(args, taskDirInput, json);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const command = args._.length > 0 ? args._.join(" ") : "";
        let result;
        try {
          result = require("../lib/check").check({ taskDir: taskDirAbs, projectDir: key.main_root, command, capture: json });
        } catch (err) {
          refuse(err, json);
        }
        if (json) output(true, result);
        process.exit(result.exit);
      }

      case "setup run": {
        if (args._.length > 1) throw argError("setup run takes one worktree path");
        const wt = path.resolve(args._.length > 0 ? args._[0] : ".");
        let out;
        try {
          out = require("../lib/setup").run(wt);
        } catch (err) {
          refuse(err, json);
        }
        if (json) output(true, out);
        process.exit(out.exit_code === null ? 1 : out.exit_code);
        break;
      }

      case "setup status": {
        if (args._.length > 1) throw argError("setup status takes one worktree path");
        const wt = path.resolve(args._.length > 0 ? args._[0] : ".");
        const st = require("../lib/setup").statusOf(wt);
        if (json) { output(true, st); break; }
        const lines = [`state: ${st.state}${st.pane ? ` (${st.pane_kind} pane ${st.pane})` : ""}`];
        if (st.command) lines.push(`command: ${st.command}`);
        if (st.pid) lines.push(`pid: ${st.pid}`);
        if (st.started_at) lines.push(`started: ${st.started_at}`);
        if (st.finished_at) lines.push(`finished: ${st.finished_at}`);
        if (st.exit_code !== null) lines.push(`exit: ${st.exit_code}`);
        if (st.error) lines.push(`error: ${st.error}`);
        if (st.tail) lines.push(`tail:\n${st.tail}`);
        lines.push(`marker: ${st.marker}`, `log: ${st.log}`);
        console.log(lines.join("\n"));
        break;
      }

      case "setup wait": {
        if (args._.length > 1) throw argError("setup wait takes one worktree path");
        const wt = path.resolve(args._.length > 0 ? args._[0] : ".");
        const budget = getArg(args, "--timeout");
        const r = require("../lib/setup").wait(wt, budget === undefined ? undefined : Number(budget));
        if (r.state === "complete") { console.log("worktree setup complete"); break; }
        if (r.state === "failed") {
          const code = r.exit_code === null ? "did not complete" : `exit ${r.exit_code}`;
          process.stderr.write(`worktree setup failed (${code}${r.error ? `: ${r.error}` : ""})\n${r.tail || ""}\nRemedy: fix it by hand in the worktree, then \`a setup run ${wt}\` (or \`a start\` again)\n`);
          process.exit(1);
        }
        process.stderr.write(`worktree setup is still pending${r.pane ? ` (pane ${r.pane})` : ""}; inspect it: a setup status ${wt}\n`);
        process.exit(3);
        break;
      }

      case "doctor": {
        // The install's one health check. One classification drives the
        // output: `actions` rows need the owner now and each carries its
        // remedy (registration, resolution, the database's surroundings,
        // worktrees, strays, drift); every standing fact is collected into
        // `info` (printed once under --verbose, served whole by --json), and
        // the default output is the verdict, the action rows and one state
        // line — ok if and only if actions is empty. `a doctor hooks
        // [off|on]` flips or shows the kill switch instead.
        if (args._[0] === "hooks") {
          const flag = _adapter.hooksDisabledPath();
          const sub = args._[1];
          if (args._.length > 2 || (sub !== undefined && sub !== "off" && sub !== "on")) {
            process.stderr.write("usage: a doctor hooks [off|on]\n");
            process.exit(2);
          }
          if (sub === "off" && !fs.existsSync(flag)) {
            fs.mkdirSync(path.dirname(flag), { recursive: true });
            fs.writeFileSync(flag, new Date().toISOString() + "\n");
          } else if (sub === "on") {
            try {
              fs.unlinkSync(flag);
            } catch (err) {
              if (err.code === "EPERM" || err.code === "EACCES") {
                process.stderr.write(`cannot remove ${flag} (immutable? run: chflags nouchg ${flag})\n`);
                process.exit(1);
              }
              if (err.code !== "ENOENT") throw err;
            }
          }
          const off = fs.existsSync(flag);
          if (json) output(json, { hooks: off ? "off" : "on", flag });
          else console.log(`hooks ${off ? "OFF" : "ON"} (${flag})`);
          break;
        }
        const verbose = args["--verbose"] === true;
        const os = require("os");
        const stubA = require("../install-snapshot").resolveStubA(os.homedir());
        const dbInfo = require("../lib/db").describe();
        const installer = _adapter.installerModule();
        const settings = installer.readSettings();
        const actions = [];
        const action = (kind, text, remedy) => actions.push({ kind, text, remedy });
        let hooksRegistered = 0;
        for (const [event, entries] of Object.entries(installer.AGENTS_HOOKS)) {
          for (const entry of entries) {
            const script = entry.hooks[0].command.split("/").pop();
            const present = (settings.hooks && settings.hooks[event] || []).some(
              (e) => e.hooks && e.hooks.some((h) => h.command && h.command.includes(script))
            );
            if (present) hooksRegistered++;
            else action("hook_registration", `${event}/${script}: not registered in the settings file`, "./install.sh --hooks");
            const local = path.join(__dirname, "..", "..", "hooks", script);
            if (!fs.existsSync(local)) action("hook_script", `${script}: missing in hooks/`, "fix the engine checkout (report it)");
          }
        }
        if (!installer.isAdditionalDirPresent(settings)) {
          action("permissions", "permissions.additionalDirectories: missing ~/.agents/tasks", "./install.sh");
        }
        const aLink = path.join(os.homedir(), ".local", "bin", "a");
        if (!fs.existsSync(aLink)) action("a_link", "~/.local/bin/a: missing", "./install.sh");
        if (stubA.via === "checkout") action("stub_a", "hook stubs fall back to the checkout", "./install.sh");
        if (stubA.via === "none") action("stub_a", "no installed a in ~/.agents/bin", "./install.sh");
        const nodeLink = path.join(os.homedir(), ".agents", "bin", "node");
        const nodeInfo = { path: null, sqlite: null };
        try {
          nodeInfo.path = fs.realpathSync(nodeLink);
          nodeInfo.sqlite = require("child_process").spawnSync(nodeLink, ["-e", 'require("node:sqlite")'], { stdio: "ignore" }).status === 0;
          if (!nodeInfo.sqlite) action("node_sqlite", `${nodeLink} cannot load node:sqlite; hooks skip while the database is on`, "./install.sh");
        } catch {
          action("node_link", "recorded node missing: ~/.agents/bin/node", "./install.sh");
        }
        // D44: check zmx is installed and at least version 0.8.1.
        const startLib = require("../lib/start");
        if (!startLib.zmxAvailable()) {
          action("zmx", "zmx not installed; sessions will run in foreground or tmux (--tmux)", "brew install neurosnap/tap/zmx");
        } else if (!startLib.zmxVersionOk()) {
          action("zmx", "zmx version < 0.8.1; releases ≤ 0.8.1 replay only part of the scrollback on reattach", "brew upgrade zmx");
        }
        // Count today's five-field outcome lines; other lines are ignored.
        const hookLogPath = _adapter.hookLogPath();
        const hookOutcomes = { recorded: 0, not_recorded: 0, error: 0 };
        if (fs.existsSync(hookLogPath)) {
          const today = new Date().toISOString().slice(0, 10);
          const logLines = fs.readFileSync(hookLogPath, "utf8").split("\n").filter(Boolean);
          for (const line of logLines) {
            const parts = line.split("\t");
            if (parts.length < 5 || !parts[0].startsWith(today)) continue;
            if (Object.hasOwn(hookOutcomes, parts[3])) hookOutcomes[parts[3]]++;
          }
        }
        const worktreeLib = require("../lib/worktree");
        let worktreeRows = [];
        let cleanResult = null;
        const purgedRepos = [];
        const cleanFlag = args["--clean"] === true;
        try {
          if (cleanFlag) {
            cleanResult = worktreeLib.cleanSurvey();
            if (!json) {
              for (const r of cleanResult.removed) process.stderr.write(`worktree removed: ${r.path}\n`);
              for (const r of cleanResult.kept) process.stderr.write(`worktree kept: ${r.path} (${r.reason})\n`);
            }
          }
          worktreeRows = worktreeLib.survey();
        } catch (surveyErr) {
          action("scan", `cannot survey ${worktreeLib.worktreesRoot()}: ${surveyErr.message}`, "fix the path or report the engine error");
        }
        for (const row of worktreeRows) {
          if (row.removable) action("worktree", `worktree ${row.path} (stale)`, "a doctor --clean");
        }
        // D40: trash dir writable
        const { trashRoot } = require("../lib/trash");
        const trashDirPath = trashRoot();
        try {
          fs.mkdirSync(trashDirPath, { recursive: true });
          const testFile = path.join(trashDirPath, ".doctor-write-test");
          fs.writeFileSync(testFile, "x");
          fs.unlinkSync(testFile);
        } catch {
          action("trash", `trash dir not writable: ${trashDirPath}`, "fix the path's permissions");
        }
        // D40: last snapshot younger than 24h
        const { tasksRootBase } = require("../lib/tasks-root");
        const docRoot = tasksRootBase();
        let snapshotAgeH = null;
        if (fs.existsSync(path.join(docRoot, ".git"))) {
          try {
            const lastCommitTs = require("child_process").execSync("git log -1 --format=%ci", { cwd: docRoot, stdio: "pipe", timeout: 10000 }).toString().trim();
            snapshotAgeH = (Date.now() - new Date(lastCommitTs).getTime()) / 3600000;
          } catch {}
          if (snapshotAgeH !== null && snapshotAgeH > 24) {
            action("snapshot_age", `last snapshot ${Math.round(snapshotAgeH)}h old`, "a tasks backup");
          }
        } else {
          action("snapshot_repo", "central root is not a git repo", "a tasks backup --init");
        }
        // The file step's guards: pending folds and task notes outside a
        // central folder (C14). The strays collapse to one count row; each
        // path with its destination prints under --verbose.
        const strayRows = [];
        if (dbInfo.present && dbInfo.schema_version === 2) {
          try {
            const dbLib = require("../lib/db");
            for (const f of dbLib.listPendingFolds()) {
              const task = dbLib.getTask(f.task_id);
              const name = task ? `${task.repo_key}/${task.dir_name}` : `task ${f.task_id}`;
              const dest = task ? task.task_dir || name : name;
              action("pending_fold", `pending fold for ${name}: ${f.path} (no verb folds)`, `move it into ${dest} by hand`);
            }
            for (const repo of dbLib.listRepos()) {
              const central = path.join(require("../lib/tasks-root").tasksRootBase(), repo.key);
              for (const stray of worktreeLib.strayNotesInRepo(repo.main_root)) {
                strayRows.push({ path: stray, central });
              }
            }
            if (strayRows.length > 0) {
              action("strays", `task notes outside the central folder: ${strayRows.length} locations`, "move them into the central root (a doctor --verbose lists each)");
            }
          } catch (foldErr) {
            action("scan", `cannot scan pending folds: ${foldErr.message}`, "fix the path or report the engine error");
          }
          // The repos the roster leaves out: a gone checkout holding no active
          // task. One action row each; --clean purges the rows (history stays).
          try {
            const rosterLib = require("../lib/roster");
            const gone = rosterLib.goneRepos();
            if (cleanFlag) {
              const dbLib = require("../lib/db");
              for (const repo of gone) {
                dbLib.deleteRepo(repo.key);
                purgedRepos.push({ key: repo.key, main_root: repo.main_root });
                if (!json) process.stderr.write(`repo row purged: ${repo.key} (${repo.main_root} was gone)\n`);
              }
            } else {
              for (const repo of gone) {
                action("gone_repo", `repo ${repo.key} (${repo.main_root} gone)`, "purge: a doctor --clean");
              }
            }
          } catch (reposErr) {
            action("scan", `cannot scan repos: ${reposErr.message}`, "fix the path or report the engine error");
          }
        }
        for (const name of HOOK_NAMES) {
          try {
            _adapter.hookHandler(name);
          } catch (loadErr) {
            action("hook_load", `hook ${name} failed to load: ${loadErr.message}; hooks fail open`, "fix it or run `a doctor hooks off`");
          }
        }
        // The agent drift check expects what a fresh install would write: the
        // engine's templates rendered under the install's own config
        // resolution, so a config-driven install matches by construction and a
        // hand-edit or a stale install is the honest flag. An engine copy that
        // predates agent templates in snapshots (templates/agents holding only
        // the memory seeds, no defaults/) skips the leg — one install cycle, no
        // standing row.
        const repoRoot = path.resolve(__dirname, "..", "..");
        const installedAgentsDir = _adapter.agentsDir();
        const templatesDir = path.join(repoRoot, "templates", "agents");
        const agentTemplatesPresent = fs.existsSync(templatesDir)
          && fs.readdirSync(templatesDir).some((n) => n.endsWith(".template.md"));
        if (agentTemplatesPresent) {
          const doctorLib = require("../lib/doctor");
          const exp = doctorLib.expectedAgents(repoRoot);
          if (exp.error) {
            action("agents_generate", `cannot derive the expected agents: ${exp.error}`, "fix ~/.agents/config.json or run ./install.sh");
          } else {
            for (const row of doctorLib.agentDriftRows(installedAgentsDir, path.join(exp.dir, _adapter.harnessName(), "agents"))) {
              action("agent_drift", `agent file ${row.name}: ${row.problem === "missing" ? "missing in the agents directory" : "differs from the config-derived expected"}`, "./install.sh; hand-tuning belongs in ~/.agents/config.json");
            }
          }
          try { require("../lib/trash").removeTempDir(exp.dir); } catch { /* a leftover agents- temp dir is inert */ }
        } else if (verbose && !json) {
          process.stderr.write(`agent drift skipped: no agent templates under ${templatesDir} in this engine copy\n`);
        }
        const installedHooksDir = _adapter.hooksDir();
        const sourceHooksDir = path.join(repoRoot, "hooks");
        if (fs.existsSync(sourceHooksDir)) {
          for (const name of fs.readdirSync(sourceHooksDir)) {
            if (!name.endsWith(".sh")) continue;
            const installedPath = path.join(installedHooksDir, name);
            const sourcePath = path.join(sourceHooksDir, name);
            if (!fs.existsSync(installedPath)) {
              action("hook_stub", `hook stub ${name}: missing in the hooks directory`, "./install.sh");
              continue;
            }
            try {
              const installed = fs.readFileSync(installedPath, "utf8");
              const source = fs.readFileSync(sourcePath, "utf8");
              if (installed !== source) {
                action("hook_stub", `hook stub ${name}: differs from hooks/`, "./install.sh");
              }
            } catch {}
          }
        }
        // D51: the kill switch is an action row, not a banner.
        const hooksOff = _adapter.hooksDisabled();
        if (hooksOff) action("hooks_off", `hooks are off (${_adapter.hooksDisabledPath()})`, "a doctor hooks on");
        const info = {
          a_resolves_to: stubA.path, a_via: stubA.via, db: dbInfo, node: nodeInfo,
          hooks: hooksOff ? "off" : "on", hooks_registered: hooksRegistered,
          hook_outcomes: hookOutcomes, worktrees: worktreeRows, strays: strayRows.map((s) => s.path),
        };
        const docResult = { ok: actions.length === 0, actions, info };
        if (cleanResult) docResult.clean = { ...cleanResult, purged_repos: purgedRepos };
        if (json) {
          output(true, docResult);
        } else {
          console.log(actions.length === 0 ? "a doctor: ok" : `a doctor: ${actions.length} item${actions.length === 1 ? "" : "s"} need action`);
          for (const a of actions) console.log(`action: ${a.text} — ${a.remedy}`);
          const keptWorktrees = worktreeRows.filter((r) => !r.removable).length;
          const snapshotState = snapshotAgeH === null ? "no snapshot" : `snapshot ${Math.round(snapshotAgeH)}h old`;
          console.log(`state: ${dbInfo.tasks ?? 0} tasks, ${dbInfo.sessions ?? 0} sessions, ${keptWorktrees} worktrees kept, hooks ${hooksOff ? "off" : "on"}, ${snapshotState}`);
          if (verbose) {
            process.stderr.write(`a (hook stubs): ${stubA.path || "(none)"} (via ${stubA.via})\n`);
            printDbDoctor(dbInfo);
            process.stderr.write(`node (hook stubs): ${nodeInfo.path || "(none)"}\n`);
            process.stderr.write(`Hook log: ${hookLogPath}\n`);
            process.stderr.write(`Hook outcomes today: recorded ${hookOutcomes.recorded}, not recorded ${hookOutcomes.not_recorded}, errors ${hookOutcomes.error}\n`);
            for (const row of worktreeRows) process.stderr.write(`worktree: ${worktreeLib.surveyLine(row)}\n`);
            for (const s of strayRows) process.stderr.write(`task notes outside the central folder: ${s.path} (no verb folds; move it into ${s.central} by hand)\n`);
          }
        }
        if (actions.length > 0) process.exit(1);
        break;
      }

      default:
        process.stderr.write(`Usage: a <verb> [args] [--json]\n`);
        process.stderr.write(`Verbs: ${VERB_LINES.map(([verb]) => verb).join(" ")}\n`);
        process.stderr.write(`\`a --help --all\` lists the machine verbs.\n`);
        process.exit(2);
    }
  } catch (err) {
    if (err.name === "LockHeldError") {
      if (json) console.log(JSON.stringify({ error: "lock_held", holder: err.holder }));
      else process.stderr.write(`Lock held by ${err.holder.session_id} (pid ${err.holder.pid})\n`);
      process.exit(3);
    }
    if (err.notFound) {
      if (json) console.log(JSON.stringify({ error: "not_found", message: err.message }));
      else process.stderr.write(err.message + "\n");
      process.exit(4);
    }
    if (json) console.log(JSON.stringify({ error: err.code || "validation", message: err.message, ...err.detail }));
    process.stderr.write(err.message + "\n");
    process.exit(Number.isInteger(err.exitCode) ? err.exitCode : 2);
  }
}

function printDbDoctor(info) {
  const nodeLine = info.node_ok
    ? `node: ${process.version} (node:sqlite ok)`
    : `node: ${process.version} needs 22.5+ for the database`;
  process.stderr.write(nodeLine + "\n");
  if (!info.path) { process.stderr.write(`db: ${info.error}\n`); return; }
  if (!info.present) {
    process.stderr.write(`db: none at ${info.path} (a task new creates it)\n`);
    return;
  }
  const age = info.backup_age_hours === null ? "no backup yet" : `backup ${Math.floor(info.backup_age_hours)}h old`;
  if (info.error) {
    process.stderr.write(`db: ${info.path} unreadable: ${info.error}\n`);
    return;
  }
  const folds = info.pending_folds === null ? "" : `, ${info.pending_folds} pending folds`;
  process.stderr.write(`db: ${info.path} — ${info.tasks} tasks, schema v${info.schema_version}${folds}, ${age}\n`);
  for (const bak of info.v1_backups || []) process.stderr.write(`v1 backup: ${bak}\n`);
}

function argError(msg) {
  const e = new Error(msg);
  e.name = "ArgError";
  return e;
}

function notFoundError(msg) {
  const e = new Error(msg);
  e.notFound = true;
  return e;
}

function slugify(text) {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
}

// Single source of truth for command usage. Drives both `--help` output and
// the Groups line in the usage error so they cannot drift apart.
// Entry: { g: group, c: subcmd|null, d: desc, f: [[flag, required, valueHint, desc]], ex: example }
const COMMANDS = [
  { g: "ls", c: null, d: "List tasks with their next step and live sessions: live, or not done, written in the last 7 days and checkout present; one task with its phases.",
    f: [["<task>", false, "", "number, NNN-slug or slug: show that task"], ["--all", false, "", "every active task: done, stale and gone-checkout ones too"], ["--repo", false, "<path>", "limit to the repo containing <path>"], ["--json", false, "", "roster JSON: { data_version, tasks (task_status, phases_checked, phases_total, current_phase, advice, landing, live, resumable), sessions (origin, main_root), repos, ended_sessions }"]],
    ex: "a ls --json" },
  { g: "start", c: null, d: "Open a Conductor (default), Courier or Coordinator session on a task, in zmx; new tasks and worktrees on request; a start on the main checkout fast-forwards its base branch to origin when clean.",
    f: [["<task>", false, "", "number, NNN-slug or slug of an open task"], ["--title", false, "<text>", "create a task with this title"], ["--conductor", false, "", "run the Conductor (default)"], ["--courier", false, "", "run the Courier (new tasks are fast and minor)"], ["--coordinator", false, "", "run the Coordinator (the roster's coordinator)"], ["--worktree", false, "", "use the task's worktree, creating it if needed"], ["--here", false, "", "use the main checkout even when a session runs there"], ["--repo", false, "<path>", "repo containing <path> (default: cwd)"], ["--no-attach", false, "", "start detached"], ["--json", false, "", "print the session as JSON (implies --no-attach)"], ["-- <args>", false, "", "passed on to the agent"]],
    ex: "a start 002 --worktree",
    env: ["AGENTS_DIRENV_TIMEOUT_MS=<ms>  override the 30 s direnv evaluation timeout",
      "AGENTS_SETUP_TIMEOUT_MS=<ms>  override the 850 s worktree setup budget (the runner and the env wait)",
      "AGENTS_SETUP_LAUNCH_BELT_MS=<ms>  override the 10 s setup launch belt"],
    fails: [
      "<flag> needs a value",
      "Unknown flag <flag> for a <verb>",
      "a <verb> takes one <task>, got another: <arg> (quote a multi-word title)",
      "launch.env_file is not a readable file: <path>",
      "the launch env file could not be sourced: <path>",
      "Not inside a git repository: <error>",
      "a <resume|attach> needs a task or a session",
      "No session for <input>",
      "Session <id> runs outside zmx (pid <pid>); switch to its terminal",
      "No live session for <target>; resume it with: a resume <target>",
      "zmx run failed: <why>",
      "could not start the agent: <error>",
      "give a task or --title, not both",
      'No task <task> in <repo>; create one with --title "<task>"',
      "a start needs a <task> or --title",
      "Cancelled",
      "Task <name> already has a live <agent>; resume it with: a resume <id> (or a resume <name> from inside the repo)",
      "Session <id> is already live in <dir>; resume it with: a resume <id>",
      "Session <id> is already live in <dir> (pid <pid>, outside zmx); a resume <id> cannot reach it, switch to its terminal",
      "Checkout <path> has a live <agent> on <task>; pass --worktree to use a worktree or --here to share the checkout",
      "<path> exists but is not a worktree of this repo",
      "Manifest overlap with live tasks: <names>",
