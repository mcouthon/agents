#!/usr/bin/env node
"use strict";

const path = require("path");
const fs = require("fs");

const VALUE_FLAGS = new Set([
  "--repo", "--path", "--cwd", "--agent", "--session-id", "--terminal-id", "--counter",
  "--title", "--slug", "--mode", "--task-dir", "--phase-id", "--phase-status",
  "--owner", "--task-status", "--flag-id", "--type", "--message", "--worktree",
  "--pid", "--description", "--phases-json", "--blocked-by", "--parallel-group",
  "--initiator", "--repo-key", "--origin", "--transcript-path", "--source",
  "--previous-session-id", "--workflow-id", "--commitment-id", "--project-id",
  "--tmux-server", "--tmux-session", "--task", "--lease-ttl",
  "--root", "--checkpoint-id", "--chosen", "--question", "--report-json",
  "--knob", "--value", "--file", "--plan-path", "--options-json",
  "--session-dir",
  "--name", "--commits",
  "--tier", "--older-than", "--since", "--status",
]);

function parseArgs(argv) {
  const args = {};
  const positional = [];
  let i = 0;
  while (i < argv.length) {
    const arg = argv[i];
    if (arg === "--") {
      positional.push(...argv.slice(i + 1));
      break;
    }
    if (arg.startsWith("--")) {
      const eq = arg.indexOf("=");
      if (eq >= 0) {
        args[arg.slice(0, eq)] = arg.slice(eq + 1);
        i++;
      } else if (VALUE_FLAGS.has(arg) && i + 1 < argv.length && argv[i + 1] !== "--") {
        // `--` is a separator, never a flag value; a bare value-flag before
        // `--` (e.g. `a cc --task <slug> --worktree -- --add-dir /x`) must not
        // swallow it.
        args[arg] = argv[i + 1];
        i += 2;
      } else {
        args[arg] = true;
        i++;
      }
    } else {
      positional.push(arg);
      i++;
    }
  }
  args._ = positional;
  return args;
}

function resolveSessionId(args) {
  const { validateSessionId } = require("../lib/session");
  if (args["--session-id"]) {
    validateSessionId(args["--session-id"]);
    return args["--session-id"];
  }
  if (process.env.AGENTS_SESSION_ID) {
    validateSessionId(process.env.AGENTS_SESSION_ID);
    const session = require("../lib/session").find({ session_id: process.env.AGENTS_SESSION_ID });
    if (session) return process.env.AGENTS_SESSION_ID;
  }
  return `pid-${process.pid}`;
}

function resolveRepo(args) {
  const repoPath = args["--repo"] || args["--path"] || ".";
  return require("../lib/repo").repoKey(repoPath);
}

function resolveTaskDir(input, key) {
  if (!input) return input;
  // D35: move-on-first-touch — if a repo-local .tasks/ exists, move it to the
  // central root before resolving. Self-exclusion via CLAUDE_CODE_SESSION_ID.
  try {
    require("../lib/tasks-root").ensureMigrated(key);
  } catch (err) {
    if (err.refused || err.failClosed) throw err;
    // Other errors are non-fatal — proceed with central path
  }
  if (path.isAbsolute(input)) return input;
  // D35: tasks live at the central root, not repo-local .tasks/.
  // A numeric or slug input resolves through tasksRoot().
  const { tasksRoot } = require("../lib/tasks-root");
  const root = tasksRoot(key);
  if (/^\d+$/.test(input)) {
    if (fs.existsSync(root)) {
      const padded = input.padStart(3, "0");
      const match = fs.readdirSync(root).find((n) => n.startsWith(padded + "-"));
      if (match) return path.join(root, match);
    }
  }
  // Try matching a slug in the central root
  if (fs.existsSync(root)) {
    const match = fs.readdirSync(root).find((n) => n.endsWith("-" + input) || n === input);
    if (match) return path.join(root, match);
  }
  return path.join(root, input);
}

// The SessionStart hook runs in a transient shell; process.ppid is that shell,
// which exits before the session ends, so a lease keyed on it always looks
// "dead" and a second session steals it. CLAUDE_PID is the long-lived claude
// process the lease's liveness must track; fall back to ppid when it is unset
// (e.g. a manual, non-Claude invocation).
function resolveHookPid() {
  const envPid = process.env.CLAUDE_PID ? parseInt(process.env.CLAUDE_PID, 10) : NaN;
  return Number.isInteger(envPid) ? envPid : process.ppid;
}

function getArg(args, ...names) {
  for (const n of names) {
    if (args[n] !== undefined && args[n] !== true) return args[n];
  }
  return undefined;
}

function output(json, value) {
  if (json) {
    console.log(JSON.stringify(value, null, 2));
  } else if (typeof value === "string") {
    console.log(value);
  } else {
    console.log(JSON.stringify(value, null, 2));
  }
}

const NO_SUBCMD_GROUPS = new Set(["policy", "launch", "next", "report", "land", "doctor"]);
const CC_SUBCMDS = new Set(["ls", "attach", "kill"]);

function main() {
  const argv = process.argv.slice(2);
  const group = argv[0] || "";
  // A subcommand is a bare token; a flag (starts with "--") or nothing in the
  // second position means the group takes flags directly (e.g. `a cc --task`).
  const hasSubCmd = argv[1] !== undefined && !argv[1].startsWith("--");
  let cmd, rest;
  if (NO_SUBCMD_GROUPS.has(group) || !hasSubCmd) {
    cmd = "";
    rest = argv.slice(1);
  } else if (group === "cc" && !CC_SUBCMDS.has(argv[1])) {
    // `a cc courier`, `a cc <slug>` — not a real subcommand; treat as bare cc.
    cmd = "";
    rest = argv.slice(1);
  } else {
    cmd = argv[1] || "";
    rest = argv.slice(2);
  }
  const args = parseArgs(rest);
  const json = args["--json"] === true;

  // --help/-h short-circuit: print usage and exit 0 before any argument
  // validation or side effect. Scans the raw argv so `--help` wins even when
  // other valid flags are present (e.g. `a state update --task-dir <dir> --help`).
  if (argv.some((a) => a === "--help" || a === "-h")) {
    const helpGroup = (group === "--help" || group === "-h") ? "" : group;
    const helpCmd = (cmd === "--help" || cmd === "-h") ? "" : cmd;
    printHelp(helpGroup, helpCmd);
    process.exit(0);
  }

  let sessionId;
  try {
    sessionId = resolveSessionId(args);

    // `a hook <name>` — dispatcher for all enforcement hooks.
    // Each hook shell stub execs this; logic lives in scripts/lib/hook.js.
    // Handled before the switch because the hook name is variable.
    if (group === "hook") {
      let stdinData = "";
      try { stdinData = fs.readFileSync("/dev/stdin", "utf8"); } catch {}
      let hookInput = {};
      try { hookInput = stdinData ? JSON.parse(stdinData) : {}; } catch {}
      const result = require("../lib/hook").runHook(cmd, hookInput);
      if (result.output) console.log(JSON.stringify(result.output));
      process.exit(result.exitCode || 0);
    }

    switch (`${group} ${cmd}`.trim()) {
      case "repo key": {
        const key = resolveRepo(args);
        output(json, key);
        break;
      }

      case "tasks root": {
        const key = resolveRepo(args);
        const root = require("../lib/tasks-root").tasksRoot(key);
        output(json, { root });
        break;
      }

      case "task create": {
        const title = getArg(args, "--title");
        if (!title) throw argError("--title is required");
        const slug = getArg(args, "--slug") || slugify(title);
        const mode = getArg(args, "--mode");
        const tier = getArg(args, "--tier");
        const description = getArg(args, "--description") || "";
        const phasesJson = getArg(args, "--phases-json");
        const phases = phasesJson ? JSON.parse(phasesJson) : [];
        const key = resolveRepo(args);
        const result = require("../lib/task").createTask({
          repo: key, title, slug, mode, tier, phases, description, session_id: sessionId,
        });
        output(json, result);
        break;
      }

      case "task list": {
        const key = resolveRepo(args);
        const store = require("../lib/store");
        let index = store.readIndex(key.main_root);
        if (!index) index = store.rebuildIndex(key.main_root, sessionId);
        if (json) {
          output(true, index);
        } else {
          for (const t of index.tasks || []) {
            console.log(`${t.dir}\t${t.status}\t${t.completed_phases}/${t.total_phases}`);
          }
        }
        break;
      }

      case "task read": {
        const taskDirInput = getArg(args, "--task-dir") || (args._.length > 0 ? args._[0] : null);
        if (!taskDirInput) throw argError("--task-dir or positional arg required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const task = require("../lib/task").loadTask(taskDirAbs);
        output(json, task);
        break;
      }

      case "state update": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const phaseId = getArg(args, "--phase-id");
        const phaseStatus = getArg(args, "--phase-status");
        const owner = getArg(args, "--owner");
        const taskStatus = getArg(args, "--task-status");
        const started = args["--started"] === true;
        const completed = args["--completed"] === true;
        const blockedByRaw = getArg(args, "--blocked-by");
        const parallelGroup = getArg(args, "--parallel-group");
        const commitsRaw = getArg(args, "--commits");
        const counterRaw = getArg(args, "--counter");
        const commits = commitsRaw !== undefined
          ? commitsRaw.split(",").map((s) => s.trim()).filter(Boolean)
          : undefined;

        const result = require("../lib/state-ops").updateState(key.main_root, taskDir, {
          phase_id: phaseId !== undefined ? parseInt(phaseId, 10) : undefined,
          phase_status: phaseStatus,
          owner,
          task_status: taskStatus,
          started,
          completed,
          blocked_by: blockedByRaw !== undefined
            ? blockedByRaw.split(",").map((s) => parseInt(s.trim(), 10))
            : undefined,
          parallel_group: parallelGroup,
          commits,
          counters: counterRaw !== undefined
            ? Object.fromEntries(counterRaw.split(",").map((kv) => {
                const [k, v] = kv.split("=").map((s) => s.trim());
                return [k, k === "autofix_ran" ? v === "true" : parseInt(v, 10)];
              }))
            : undefined,
        });
        output(json, { updated: result.summary });
        break;
      }

      case "state flag": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const phaseId = getArg(args, "--phase-id");
        if (!phaseId) throw argError("--phase-id is required");
        const type = getArg(args, "--type");
        if (!type) throw argError("--type is required");
        const message = getArg(args, "--message");
        if (!message) throw argError("--message is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const result = require("../lib/state-ops").addFlag(
          key.main_root, taskDir, parseInt(phaseId, 10), type, message
        );
        output(json, { id: result.id, phase: parseInt(phaseId, 10), type, total_flags: result.flagCount });
        break;
      }

      case "state clear-flag": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const flagId = getArg(args, "--flag-id");
        if (!flagId) throw argError("--flag-id is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const result = require("../lib/state-ops").clearFlag(key.main_root, taskDir, flagId);
        output(json, { removed: result.flagId, remaining: result.remainingFlags });
        break;
      }

      case "state add-phases": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const phasesJson = getArg(args, "--phases-json");
        if (!phasesJson) throw argError("--phases-json is required");
        const newPhases = JSON.parse(phasesJson);
        if (!Array.isArray(newPhases) || newPhases.length === 0) throw argError("phases must be a non-empty array");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const result = require("../lib/state-ops").addPhases(key.main_root, taskDir, newPhases);
        output(json, { added: result.count, summary: result.summary, total: result.totalPhases });
        break;
      }

      case "state prime": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const task = require("../lib/task").loadTask(taskDirAbs);
        const phases = task.phases || [];
        const doneCount = phases.filter((p) => p.status === "done").length;
        const current = phases.find((p) => p.status !== "done" && p.status !== "failed" && p.status !== "skipped");
        const prime = {
          task: task.slug,
          status: task.status,
          phases_done: doneCount,
          phases_total: phases.length,
          current: current ? `Phase ${current.id} (${current.name}) -- ${current.status}, ${current.owner || "unowned"}` : "All phases complete",
          flags: (task.flags || []).length,
        };
        output(json, prime);
        break;
      }

      case "policy": {
        const policy = require("../lib/policy").resolvePolicy(
          args["--path"] || args["--repo"] || "."
        );
        output(json, policy);
        break;
      }

      case "session register": {
        const sessionLib = require("../lib/session");
        if (args["--hook"] === true) {
          let stdinData = "";
          try {
            stdinData = fs.readFileSync("/dev/stdin", "utf8");
          } catch {}
          let hookInput = {};
          try { hookInput = JSON.parse(stdinData); } catch {}

          if (hookInput.agent_id) { process.exit(0); }

          const sid = hookInput.session_id || process.env.AGENTS_SESSION_ID;
          if (!sid) { process.exit(0); }

          const cwd = hookInput.cwd || process.cwd();
          let repoKey;
          try { repoKey = require("../lib/repo").repoKey(cwd); } catch { repoKey = null; }

          let taskDir = null;
          let projectDir = null;
          if (process.env.AGENTS_SESSION_DIR) {
            const existing = sessionLib.readRegistration(process.env.AGENTS_SESSION_DIR);
            if (existing && existing.task_dir) {
              taskDir = existing.task_dir;
              projectDir = repoKey ? repoKey.main_root : (existing.cwd || cwd);
            }
          }

          let hookConfig = {};
          try { hookConfig = require("../lib/config").loadConfig(); } catch {}
          const leaseTtl = hookConfig.lease && hookConfig.lease.ttl_ms;

          const result = sessionLib.register({
            session_id: sid,
            pid: resolveHookPid(),
            cwd,
            agent: hookInput.agent_type || hookInput.agent || null,
            repo_key: repoKey ? repoKey.key : null,
            task_dir: taskDir,
            project_dir: projectDir,
            transcript_path: hookInput.transcript_path || null,
            source: hookInput.source || null,
            origin: process.env.AGENTS_SESSION_DIR ? null : "external",
            lease_ttl_ms: leaseTtl,
          });

          const port = hookConfig.pav && hookConfig.pav.port;
          if (port) sessionLib.postToPav(result.registration, port);

          if (result.registration.parent_session_id) {
            // Nested process (D28): registered under its own id, parent keeps
            // the registration and the task lease. No task priming.
            console.log(`Nested session under ${result.registration.parent_session_id}; parent retains the task lease.`);
          } else if (result.lease && result.lease.claimed === false && result.lease.reason === "held") {
            const h = result.lease.holder;
            process.stderr.write(`Task leased by ${h.session_id} (${h.agent || "unknown"})\n`);
            const slug = taskDir ? path.basename(taskDir) : "unknown";
            console.log(`Task ${slug} is leased by session ${h.session_id} (${h.agent || "unknown"}, since ${h.acquired_at || "unknown"}). Do not write state for it.`);
          } else if (taskDir) {
            const slug = path.basename(taskDir);
            let phaseInfo = "";
            if (projectDir) {
              try {
                const state = require("../lib/store").readState(taskDir, projectDir);
                const current = state.phases.find((p) => p.status !== "done");
                if (current) phaseInfo = `phase ${current.id} ${current.status}`;
              } catch {}
            }
            console.log(`Bound task: ${taskDir} (${slug}${phaseInfo ? ", " + phaseInfo : ""}). Call \`state_prime\` on it first.`);
          }
          process.exit(0);
        }

        const sid = getArg(args, "--session-id");
        if (!sid) throw argError("--session-id is required");
        const key = resolveRepo(args);
        const taskDirRaw = getArg(args, "--task-dir");
        const taskDir = taskDirRaw ? resolveTaskDir(taskDirRaw, key) : null;
        const result = sessionLib.register({
          session_id: sid,
          pid: getArg(args, "--pid") ? parseInt(getArg(args, "--pid"), 10) : process.ppid,
          terminal_id: getArg(args, "--terminal-id"),
          session_dir: getArg(args, "--session-dir"),
          origin: getArg(args, "--origin"),
          cwd: getArg(args, "--cwd") || process.cwd(),
          agent: getArg(args, "--agent"),
          repo_key: getArg(args, "--repo-key") || key.key,
          task_dir: taskDir,
          project_dir: key.main_root,
          initiator: getArg(args, "--initiator"),
          workflow_id: getArg(args, "--workflow-id") ? parseInt(getArg(args, "--workflow-id"), 10) : undefined,
          commitment_id: getArg(args, "--commitment-id"),
          project_id: getArg(args, "--project-id"),
          transcript_path: getArg(args, "--transcript-path"),
          source: getArg(args, "--source"),
          previous_session_id: getArg(args, "--previous-session-id"),
          tmux: (getArg(args, "--tmux-server") || getArg(args, "--tmux-session"))
            ? { server: getArg(args, "--tmux-server") || "pav", session: getArg(args, "--tmux-session") || null }
            : undefined,
          lease_ttl_ms: getArg(args, "--lease-ttl") ? parseInt(getArg(args, "--lease-ttl"), 10) : undefined,
        });
        output(json, result);
        break;
      }

      case "session unregister": {
        const sessionLib = require("../lib/session");
        if (args["--hook"] === true) {
          let stdinData = "";
          try { stdinData = fs.readFileSync("/dev/stdin", "utf8"); } catch {}
          let hookInput = {};
          try { hookInput = JSON.parse(stdinData); } catch {}
          if (hookInput.agent_id) process.exit(0);
          // Act only on the caller's own session id (D28); with no id we cannot
          // safely identify the caller, so leave the registry untouched rather
          // than risk unregistering a parent session via the pointer.
          const sid = hookInput.session_id || process.env.AGENTS_SESSION_ID;
          if (sid) sessionLib.unregister(sid);
          process.exit(0);
        }
        const sid = getArg(args, "--session-id");
        if (!sid) throw argError("--session-id is required");
        const ok = sessionLib.unregister(sid);
        output(json, { unregistered: ok });
        break;
      }

      case "session touch": {
        const sessionLib = require("../lib/session");
        if (args["--hook"] === true) {
          let stdinData = "";
          try { stdinData = fs.readFileSync("/dev/stdin", "utf8"); } catch {}
          let hookInput = {};
          try { hookInput = JSON.parse(stdinData); } catch {}
          if (hookInput.agent_id) process.exit(0);
          // Act only on the caller's own session id (D28); never renew a parent
          // session's lease through the pointer.
          const sid = hookInput.session_id || process.env.AGENTS_SESSION_ID;
          if (sid) sessionLib.touch(sid);
          process.exit(0);
        }
        const sid = getArg(args, "--session-id");
        if (!sid) throw argError("--session-id is required");
        const ok = sessionLib.touch(sid);
        output(json, { touched: ok });
        break;
      }

      case "session ls": {
        const sessionLib = require("../lib/session");
        const prune = args["--prune"] === true;
        if (prune) {
          const result = sessionLib.pruneLostSessions();
          output(json, result);
          break;
        }
        const sessions = sessionLib.list();
        if (json) {
          output(true, sessions);
        } else {
          for (const s of sessions) {
            const status = s.ended_at ? "exited" : (sessionLib.isLive(s) ? "live" : "lost");
            console.log(`${s.session_id}\t${s.agent || "-"}\t${status}\t${s.cwd || "-"}\t${s.task_dir || "-"}`);
          }
        }
        break;
      }

      case "launch": {
        const agent = getArg(args, "--agent");
        const cwd = getArg(args, "--cwd");
        const worktree = getArg(args, "--worktree");
        // claude --session-id requires a UUID. resolveSessionId falls back to
        // pid-<pid> for state-mutation identity, which claude rejects, so mint
        // a UUID when none was given. (cc already mints one and passes it
        // explicitly; this covers direct `a launch` invocations.)
        const sid = getArg(args, "--session-id") || require("../lib/session").mintId();
        const launchArgs = args._ || [];
        require("../lib/launch").launch({ agent, sessionId: sid, cwd, worktree, args: launchArgs });
        break;
      }

      case "cc": {
        const ccLib = require("../lib/cc");
        // parseCcArgs handles flags before positionals (D39), "courier" as
        // shorthand for --agent Courier, and `--` passthrough.
        const ccOpts = ccLib.parseCcArgs(rest);
        ccOpts.json = json;
        // If positionals were collected and no explicit prompt, join as prompt.
        if (ccOpts.positionals && ccOpts.positionals.length > 0 && !ccOpts.prompt) {
          ccOpts.prompt = ccOpts.positionals.join(" ");
        }
        try {
          ccLib.launch(ccOpts);
        } catch (err) {
          if (json) console.log(JSON.stringify({ error: "launch", message: err.message }));
          else process.stderr.write(err.message + "\n");
          process.exit(2);
        }
        break;
      }

      case "cc ls": {
        const sessionLib = require("../lib/session");
        const ccLib = require("../lib/cc");
        const all = args["--all"] === true;
        let sessions = sessionLib.list();
        // Default: live sessions only; --all for history (D38 item 6).
        if (!all) {
          sessions = sessions.filter((s) => sessionLib.isLive(s));
        }
        // Join zmx list for mux status (D44).
        let zmxSessions = [];
        if (ccLib.zmxAvailable()) {
          zmxSessions = ccLib.zmxList();
        }
        // Mark entries whose zmx session is gone as exited.
        sessions = sessions.map((s) => {
          if (s.mux && s.mux.kind === "zmx" && !zmxSessions.includes(s.mux.name) && !s.ended_at) {
            s.ended_at = new Date().toISOString();
          }
          return s;
        });
        if (json) {
          // Additive: keep tmux_sessions (contract) and add zmx_sessions (D44).
          let tmuxSessions = [];
          try {
            const { execSync } = require("child_process");
            const out = execSync("tmux -L pav ls 2>/dev/null", { encoding: "utf8", timeout: 2000, stdio: ["pipe", "pipe", "pipe"] });
            tmuxSessions = out.trim().split("\n").filter(Boolean);
          } catch {}
          output(true, { sessions, tmux_sessions: tmuxSessions, zmx_sessions: zmxSessions });
        } else {
          for (const s of sessions) {
            const status = s.ended_at ? "exited" : (sessionLib.isLive(s) ? "live" : "lost");
            const task = s.task_dir ? path.basename(s.task_dir) : "-";
            console.log(`${s.terminal_id || s.session_id}\t${s.agent || "-"}\t${status}\t${task}\t${s.cwd || "-"}`);
          }
        }
        break;
      }

      case "cc attach": {
        const sessionLib = require("../lib/session");
        const { execSync } = require("child_process");
        const target = args._.length > 0 ? args._[0] : null;
        if (!target) throw argError("cc attach requires <id|slug>");
        const sessions = sessionLib.list();
        const found = sessions.find((s) =>
          s.terminal_id === target || s.session_id === target ||
          (s.task_dir && path.basename(s.task_dir) === target)
        );
        if (!found) throw notFoundError(`No session matching ${target}`);
        // D44: zmx attach if mux.kind is zmx; tmux attach otherwise.
        if (found.mux && found.mux.kind === "zmx") {
          try { execSync(`zmx attach ${found.mux.name}`, { stdio: "inherit" }); } catch {}
        } else {
          const tmuxSession = found.tmux && found.tmux.session ? found.tmux.session : `pav-t-${found.terminal_id || found.session_id}`;
          try { execSync(`tmux -L pav attach -t ${tmuxSession}`, { stdio: "inherit" }); } catch {}
        }
        break;
      }

      case "cc kill": {
        const sessionLib = require("../lib/session");
        const { execSync, execFileSync } = require("child_process");
        const target = args._.length > 0 ? args._[0] : null;
        if (!target) throw argError("cc kill requires <id>");
        const sessions = sessionLib.list();
        const found = sessions.find((s) =>
          s.terminal_id === target || s.session_id === target
        );
        if (!found) throw notFoundError(`No session matching ${target}`);
        // D44: zmx kill if mux.kind is zmx; tmux kill otherwise.
        if (found.mux && found.mux.kind === "zmx") {
          try { execFileSync("zmx", ["kill", found.mux.name], { stdio: ["pipe", "pipe", "pipe"], timeout: 2000 }); } catch {}
        } else {
          const tmuxSession = found.tmux && found.tmux.session ? found.tmux.session : `pav-t-${found.terminal_id || found.session_id}`;
          try { execSync(`tmux -L pav kill-session -t ${tmuxSession}`, { stdio: "pipe" }); } catch {}
        }
        sessionLib.unregister(found.session_id);
        output(json, { killed: target, session: found.session_id });
        break;
      }

      case "task migrate": {
        const root = getArg(args, "--root");
        const all = args["--all"] === true;
        const apply = args["--apply"] === true;
        const taskDirInput = getArg(args, "--task-dir");
        const migrateOpts = { dryRun: !apply };
        if (all) {
          // D35: --all enumerates repos with .tasks/ and moves each to the
          // central root (~/.agents/tasks/<key>/). --root targets a single
          // repo; without it, enumerateReposWithTasks scans ~/code and ~/dev.
          const { enumerateReposWithTasks, ensureMigrated, hasLocalTasks } = require("../lib/tasks-root");
          const taskLib = require("../lib/task");
          let repos;
          if (root) {
            const keyObj = require("../lib/repo").repoKey(root);
            repos = [{ key: keyObj.key, main_root: keyObj.main_root }];
          } else {
            repos = enumerateReposWithTasks();
          }
          if (!apply) {
            const details = [];
            for (const repo of repos) {
              const keyObj = { key: repo.key, main_root: repo.main_root };
              const localTasksDir = path.join(repo.main_root, ".tasks");
              if (!fs.existsSync(localTasksDir)) {
                details.push({ repo_key: repo.key, main_root: repo.main_root, already_migrated: true });
                continue;
              }
              let v1count = 0, v2count = 0;
              for (const name of fs.readdirSync(localTasksDir)) {
                if (name.startsWith(".")) continue;
                const dir = path.join(localTasksDir, name);
                try { if (!fs.statSync(dir).isDirectory()) continue; } catch { continue; }
                if (taskLib.isMigrated(dir)) v2count++;
                else if (fs.existsSync(path.join(dir, "state.json"))) v1count++;
              }
              details.push({
                repo_key: repo.key,
                main_root: repo.main_root,
                v1_to_v2: v1count,
                already_v2: v2count,
                central_move: v1count + v2count,
              });
            }
            output(json, { repos: details, dryRun: true });
          } else {
            const results = [];
            for (const repo of repos) {
              const keyObj = { key: repo.key, main_root: repo.main_root };
              if (!hasLocalTasks(keyObj)) {
                results.push({ repo_key: repo.key, migrated: false, already_migrated: true });
                continue;
              }
              try {
                const result = ensureMigrated(keyObj);
                results.push({ repo_key: repo.key, ...result });
              } catch (err) {
                if (err.refused) {
                  results.push({
                    repo_key: repo.key,
                    refused: err.refused.map((s) => s.session_id || s.terminal_id || "unknown"),
                    message: err.message,
                  });
                } else {
                  results.push({ repo_key: repo.key, error: err.message });
                }
              }
            }
            output(json, { repos: results });
          }
        } else {
          if (!taskDirInput) throw argError("--task-dir or --all is required");
          const migrateRoot = root || resolveRepo(args).main_root;
          const key = root ? { main_root: root } : resolveRepo(args);
          const taskDir = resolveTaskDir(taskDirInput, key);
          const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(migrateRoot, taskDir);
          const result = require("../lib/task").migrateTask(taskDirAbs, migrateOpts);
          output(json, result);
        }
        break;
      }

      case "task render": {
        const taskDirInput = getArg(args, "--task-dir");
        const all = args["--all"] === true;
        const render = require("../lib/render");
        const taskLib = require("../lib/task");
        if (all) {
          const key = resolveRepo(args);
          const { tasksRoot } = require("../lib/tasks-root");
          const tasksDir = tasksRoot(key);
          if (!fs.existsSync(tasksDir)) { output(json, { rendered: 0 }); break; }
          let count = 0;
          for (const name of fs.readdirSync(tasksDir)) {
            if (name.startsWith(".")) continue;
            const dir = path.join(tasksDir, name);
            if (!fs.statSync(dir).isDirectory()) continue;
            if (!taskLib.isMigrated(dir)) continue;
            const task = taskLib.readTaskJson(dir);
            if (task) { render.renderStateMd(dir, task, key.main_root); count++; }
          }
          render.rebuildTasksIndex(key.main_root, sessionId);
          output(json, { rendered: count });
        } else {
          if (!taskDirInput) throw argError("--task-dir or --all is required");
          const key = resolveRepo(args);
          const taskDir = resolveTaskDir(taskDirInput, key);
          const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
          if (!taskLib.isMigrated(taskDirAbs)) throw argError("task not migrated; run `a task migrate` first");
          const task = taskLib.readTaskJson(taskDirAbs);
          if (!task) throw notFoundError("task.json not found");
          render.renderStateMd(taskDirAbs, task, key.main_root);
          render.rebuildTasksIndex(key.main_root, sessionId);
          output(json, { rendered: 1 });
        }
        break;
      }

      case "task set": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const knob = getArg(args, "--knob");
        if (!knob) throw argError("--knob is required (review_plan, review_code, approve, commit, parallel, enforcement, land, mode, tier)");
        const value = getArg(args, "--value");
        if (value === undefined) throw argError("--value is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const result = require("../lib/state-ops").setKnob(key.main_root, taskDir, knob, value);
        output(json, result);
        break;
      }

      case "task close": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const result = require("../lib/task").closeTask({ taskDir, repoKeyObj: key });
        output(json, result);
        break;
      }

      case "tasks sweep": {
        const key = resolveRepo(args);
        const apply = args["--apply"] === true;
        const olderThan = getArg(args, "--older-than");
        const olderThanDays = olderThan ? parseInt(olderThan.replace(/d$/, ""), 10) : undefined;
        const result = require("../lib/tasks-sweep").sweep({ repoKeyObj: key, apply, olderThanDays });
        output(json, result);
        break;
      }

      case "tasks backup": {
        const { initBackup, runBackup } = require("../lib/backup");
        const root = require("../lib/tasks-root").tasksRootBase();
        if (args["--init"] === true) {
          initBackup(root);
          output(json, { init: true, root, committed: true });
        } else {
          output(json, runBackup(root));
        }
        break;
      }

      case "tasks doctrine": {
        const key = resolveRepo(args);
        const doctrineJson = args._.length > 0 ? args._[0] : null;
        if (!doctrineJson) throw argError("doctrine JSON is required (e.g. '{\"default\":\"standard\",\"courier\":\"minor\"}')");
        const defaultTiers = JSON.parse(doctrineJson);
        const { updateRootIndex } = require("../lib/tasks-root");
        const result = updateRootIndex(key.key, { default_tiers: defaultTiers });
        output(json, result);
        break;
      }

      case "trash ls": {
        const olderThan = getArg(args, "--older-than");
        let olderThanDays;
        if (olderThan) {
          olderThanDays = parseInt(olderThan.replace(/d$/, ""), 10);
          if (Number.isNaN(olderThanDays)) throw argError(`--older-than must parse to a number of days, got: ${olderThan}`);
        }
        const result = require("../lib/trash").listTrash({ olderThanDays });
        output(json, result);
        break;
      }

      case "trash purge": {
        const olderThan = getArg(args, "--older-than");
        if (!olderThan) throw argError("--older-than <Nd> is required for purge");
        const olderThanDays = parseInt(olderThan.replace(/d$/, ""), 10);
        if (Number.isNaN(olderThanDays)) throw argError(`--older-than must parse to a number of days, got: ${olderThan}`);
        const result = require("../lib/trash").purgeTrash({ olderThanDays });
        output(json, result);
        break;
      }

      case "tasks ls": {
        const key = resolveRepo(args);
        const { tasksRoot } = require("../lib/tasks-root");
        const root = tasksRoot(key);
        const statusFilter = getArg(args, "--status");
        const tierFilter = getArg(args, "--tier");
        const attentionOnly = args["--attention"] === true;
        const liveOnly = args["--live"] === true;
        const since = getArg(args, "--since");
        const sinceDays = since ? parseInt(since.replace(/d$/, ""), 10) : null;

        const taskLib = require("../lib/task");
        const sessionLib = require("../lib/session");
        const { computeNext } = require("../lib/next");
        const entries = [];
        if (fs.existsSync(root)) {
          for (const name of fs.readdirSync(root)) {
            if (name.startsWith(".") || name === "archive") continue;
            const dir = path.join(root, name);
            if (!fs.statSync(dir).isDirectory()) continue;
            if (!taskLib.isMigrated(dir)) continue;
            const task = taskLib.readTaskJson(dir);
            if (!task) continue;
            if (statusFilter && task.status !== statusFilter) continue;
            if (tierFilter && (task.tier || "standard") !== tierFilter) continue;
            if (liveOnly) {
              const live = sessionLib.findLiveByRepoKey ? sessionLib.findLiveByRepoKey(key.key) : [];
              if (live.length === 0) continue;
            }
            if (sinceDays !== null) {
              const updatedMs = task.updated ? new Date(task.updated).getTime() : 0;
              if (updatedMs < Date.now() - sinceDays * 86400000) continue;
            }
            if (attentionOnly) {
              let hasAttention = false;
              if (task.checkpoints && task.checkpoints.some((c) => !c.resolved_at)) hasAttention = true;
              if (!hasAttention) {
                try {
                  const next = computeNext(task, { projectDir: key.main_root });
                  if (next.step === "blocked") hasAttention = true;
                } catch {}
              }
              if (!hasAttention) continue;
            }
            entries.push({
              slug: task.slug, dir, status: task.status,
              tier: task.tier || "standard",
              updated: task.updated,
            });
          }
        }
        if (json) {
          output(true, { tasks: entries });
        } else {
          for (const t of entries) {
            console.log(`${t.slug}\t${t.status}\t${t.tier}`);
          }
        }
        break;
      }

      case "tasks show": {
        const slugOrDir = args._.length > 0 ? args._[0] : null;
        const taskDirInput = getArg(args, "--task-dir") || slugOrDir;
        if (!taskDirInput) throw argError("task slug or --task-dir is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskLib = require("../lib/task");
        const { computeNext } = require("../lib/next");
        const task = taskLib.readTaskJson(taskDir);
        if (!task) throw notFoundError("task.json not found at " + taskDir);
        if (json) {
          const next = computeNext(task, { projectDir: key.main_root });
          output(true, { task, next });
        } else {
          console.log(`# ${task.title || task.slug}`);
          console.log(`Status: ${task.status}  Tier: ${task.tier || "standard"}  Mode: ${task.mode || "full"}`);
          console.log(`Updated: ${task.updated || ""}`);
          const next = computeNext(task, { projectDir: key.main_root });
          console.log(`Next: ${next.step}`);
          for (const p of task.phases || []) {
            console.log(`  Phase ${p.id}: ${p.name} [${p.status}]`);
          }
        }
        break;
      }

      case "next": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const explain = args["--explain"] === true;
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const taskLib = require("../lib/task");
        if (!taskLib.isMigrated(taskDirAbs)) throw argError("task not migrated; run `a task migrate` first");
        const task = taskLib.readTaskJson(taskDirAbs);
        if (!task) throw notFoundError("task.json not found");
        const policy = require("../lib/policy").resolvePolicy(key.main_root);
        const nextLib = require("../lib/next");
        const result = nextLib.computeNext(task, {
          projectDir: key.main_root, policy, taskDir: taskDirAbs, explain,
        });
        // F16/D60: apply pending transitions (non-blocking lock; the CLI is the
        // only path that pushes). If push_needed, run git push under a 60s
        // timeout before advancing.
        if (result.pending_transitions && result.phase_ids && result.phase_ids.length > 0) {
          if (result.push_needed) {
            const base = policy.base || "main";
            try {
              const { execFileSync } = require("child_process");
              execFileSync("git", ["push", "origin", base], {
                cwd: key.main_root, stdio: ["ignore", "pipe", "pipe"],
                timeout: 60000,
              });
            } catch (pushErr) {
              const blockResult = {
                step: "blocked",
                phase_ids: result.phase_ids,
                agent: null,
                reason: `git push to origin/${base} failed: ${pushErr.message}`,
                checkpoint: null,
                caps: result.caps,
                how: { tool: "Bash", command: `git push origin ${base}` },
              };
              output(json, blockResult);
              break;
            }
          }
          try {
            nextLib.applyPendingTransitions(taskDirAbs, result.pending_transitions, {
              projectDir: key.main_root,
              taskDir: taskDirAbs,
              phaseId: result.phase_ids[0],
              policy,
              gitFacts: nextLib.collectGitFacts(key.main_root),
            });
          } catch {}
        }
        // F16 orphan sweep: phase landed/done on base, direct policy, SHA not
        // on origin — push the orphaned commit.
        if (!result.pending_transitions && (result.step === "done") &&
            policy.push === "direct" && result.phase_ids && result.phase_ids.length > 0) {
          const phase = (task.phases || []).find((p) => p.id === result.phase_ids[0]);
          if (phase && (phase.status === "landed" || phase.status === "done")) {
            const base = policy.base || "main";
            const gitFacts = nextLib.collectGitFacts(key.main_root);
            const sha = phase.landed_sha || (phase.commits && phase.commits[phase.commits.length - 1]);
            if (sha && !gitFacts.isAncestor(sha, `origin/${base}`)) {
              try {
                const { execFileSync } = require("child_process");
                execFileSync("git", ["push", "origin", base], {
                  cwd: key.main_root, stdio: ["ignore", "pipe", "pipe"],
                  timeout: 60000,
                });
              } catch {}
            }
          }
        }
        if (json) {
          output(true, result);
        } else {
          const lines = [];
          lines.push(`Step: ${result.step}`);
          if (result.how && result.how.tool) {
            lines.push(`How: ${result.how.tool} — ${result.how.command}`);
          }
          if (result.phase_ids && result.phase_ids.length > 0) {
            lines.push(`Phase: ${result.phase_ids.join(", ")}`);
          }
          if (result.agent) lines.push(`Agent: ${result.agent}`);
          if (result.checkpoint) lines.push(`Checkpoint: ${result.checkpoint}`);
          if (result.reason) lines.push(`Reason: ${result.reason}`);
          if (result.explain) {
            lines.push("");
            lines.push("=== Explanation ===");
            lines.push(`Phase: ${result.explain.phase_id} [${result.explain.phase_status}]`);
            lines.push(`Rule: ${result.explain.matching_rule}`);
            if (result.explain.git_facts) {
              lines.push(`Git: base=${result.explain.git_facts.base}, branch=${result.explain.git_facts.currentBranch}`);
            }
            const knobsStr = Object.entries(result.explain.knobs || {}).map(([k, v]) => `${k}=${v}`).join(", ");
            if (knobsStr) lines.push(`Knobs: ${knobsStr}`);
            lines.push(`Artifacts: ${JSON.stringify(result.explain.artifacts)}`);
          }
          console.log(lines.join("\n"));
        }
        break;
      }

      case "report": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const phaseId = getArg(args, "--phase-id");
        if (!phaseId) throw argError("--phase-id is required");
        const agent = getArg(args, "--agent");
        if (!agent) throw argError("--agent is required (explorer|builder|reviewer|committer)");
        const force = args["--force"] === true;
        const reportJson = getArg(args, "--report-json");
        let report;
        if (reportJson) {
          report = JSON.parse(reportJson);
        } else {
          let stdinData = "";
          try { stdinData = fs.readFileSync("/dev/stdin", "utf8"); } catch {}
          report = JSON.parse(stdinData);
        }
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const taskLib = require("../lib/task");
        if (!taskLib.isMigrated(taskDirAbs)) throw argError("task not migrated; run `a task migrate` first");
        // F8: lease enforcement — check the calling session holds the lease
        if (!force) {
          const task = taskLib.readTaskJson(taskDirAbs);
          const callerSession = process.env.CLAUDE_CODE_SESSION_ID || `pid-${process.pid}`;
          const leaseHolder = task && task.lease && task.lease.session_id;
          if (leaseHolder && callerSession !== leaseHolder) {
            const sessionLib = require("../lib/session");
            const holderSession = sessionLib.find({ session_id: leaseHolder });
            const isChild = sessionLib.list().some(
              (s) => s.session_id === callerSession && s.parent_session_id === leaseHolder
            );
            if (!isChild) {
              const msg = `task is leased by session ${leaseHolder}; use --force to override`;
              if (json) console.log(JSON.stringify({ error: "lease_held", holder: leaseHolder }));
              else process.stderr.write(msg + "\n");
              process.exit(3);
            }
          }
        }
        const { validateReport, persistReport } = require("../lib/report");
        const validation = validateReport(agent, report);
        if (!validation.valid) {
          if (json) console.log(JSON.stringify({ error: "schema", errors: validation.errors }));
          else process.stderr.write("Report schema errors:\n" + validation.errors.map((e) => `  - ${e}`).join("\n") + "\n");
          process.exit(2);
        }
        const result = persistReport({
          taskDir: taskDirAbs,
          phaseId: parseInt(phaseId, 10),
          agentType: agent,
          report: validation.normalised || report,
          ctx: { projectDir: key.main_root },
          force,
        });
        output(json, result);
        break;
      }

      case "checkpoint open": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const phaseId = getArg(args, "--phase-id");
        if (!phaseId) throw argError("--phase-id is required");
        const type = getArg(args, "--type");
        if (!type) throw argError("--type is required");
        const question = getArg(args, "--question");
        if (!question) throw argError("--question is required");
        const optionsJson = getArg(args, "--options-json");
        const options = optionsJson ? JSON.parse(optionsJson) : [];
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const taskLib = require("../lib/task");
        if (!taskLib.isMigrated(taskDirAbs)) throw argError("task not migrated; run `a task migrate` first");
        const result = require("../lib/checkpoint").openCheckpoint({
          taskDir: taskDirAbs,
          phaseId: parseInt(phaseId, 10),
          type,
          question,
          options,
        });
        output(json, result);
        break;
      }

      case "checkpoint resolve": {
        const taskDirInput = getArg(args, "--task-dir");
        if (!taskDirInput) throw argError("--task-dir is required");
        const checkpointId = getArg(args, "--checkpoint-id");
        if (!checkpointId) throw argError("--checkpoint-id is required");
        const chosen = getArg(args, "--chosen");
        if (!chosen) throw argError("--chosen is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const taskLib = require("../lib/task");
        if (!taskLib.isMigrated(taskDirAbs)) throw argError("task not migrated; run `a task migrate` first");
        const result = require("../lib/checkpoint").resolveCheckpoint({
          taskDir: taskDirAbs,
          checkpointId,
          chosen,
          ctx: { projectDir: key.main_root },
        });
        output(json, result);
        break;
      }

      case "plan lint": {
        const file = getArg(args, "--file");
        if (!file) throw argError("--file is required");
        const lint = require("../lib/lint");
        const key = resolveRepo(args);
        const filePath = path.isAbsolute(file) ? file : path.resolve(key.main_root, file);
        let result;
        if (path.basename(file) === "task.md") {
          result = lint.lintTaskMd(filePath);
        } else {
          result = lint.lintPlan(filePath);
          const crossTask = lint.checkCrossTaskManifestOverlap(filePath, key.main_root);
          if (!crossTask.ok) {
            result.warnings = result.warnings || [];
            for (const o of crossTask.overlaps) {
              result.warnings.push(`cross-task overlap with ${o.task}: ${o.files.join(", ")}`);
            }
          }
        }
        output(json, result);
        if (!result.ok) process.exit(2);
        break;
      }

      case "worktree add": {
        const key = resolveRepo(args);
        const taskDirInput = getArg(args, "--task");
        const name = getArg(args, "--name");
        const force = args["--force"] === true;
        const printPath = args["--print-path"] === true;
        const result = require("../lib/worktree").add({
          projectDir: key.main_root,
          taskDir: taskDirInput,
          name,
          force,
        });
        if (printPath) {
          console.error(`Worktree created at ${result.path} on branch ${result.branch}.`);
          console.log(result.path);
        } else {
          output(json, result);
        }
        break;
      }

      case "worktree remove": {
        const key = resolveRepo(args);
        if (args["--hook"] === true) {
          let stdinData = "";
          try { stdinData = fs.readFileSync("/dev/stdin", "utf8"); } catch {}
          let hookInput = {};
          try { hookInput = JSON.parse(stdinData); } catch {}
          const wtPath = hookInput.path || hookInput.worktreePath || "";
          if (!wtPath) { process.exit(0); }
          try {
            require("../lib/worktree").remove({
              projectDir: key.main_root, path: wtPath, force: false,
            });
            console.log(`Removed worktree ${wtPath}`);
          } catch (err) {
            process.stderr.write(`worktree remove refused: ${err.message}\n`);
            process.exit(1);
          }
        } else {
          const wtPath = args._.length > 0 ? args._[0] : null;
          if (!wtPath) throw argError("worktree remove requires <path>");
          const force = args["--force"] === true;
          const result = require("../lib/worktree").remove({
            projectDir: key.main_root, path: wtPath, force,
          });
          output(json, result);
        }
        break;
      }

      case "worktree list": {
        const key = resolveRepo(args);
        const result = require("../lib/worktree").list(key.main_root);
        if (json) {
          output(true, result);
        } else {
          for (const wt of result) {
            console.log(`${wt.path}\t${wt.branch || "(detached)"}\t${wt.isMain ? "main" : "worktree"}`);
          }
        }
        break;
      }

      case "worktree clean": {
        const key = resolveRepo(args);
        const dryRun = args["--dry-run"] === true;
        const result = require("../lib/worktree").clean({
          projectDir: key.main_root, dryRun,
        });
        output(json, result);
        break;
      }

      case "worktree create": {
        if (args["--hook"] !== true) throw argError("use --hook");
        let stdinData = "";
        try { stdinData = fs.readFileSync("/dev/stdin", "utf8"); } catch {}
        let hookInput = {};
        try { hookInput = JSON.parse(stdinData); } catch {}

        const name = hookInput.name || "";
        let taskDir = null;
        let cwd = process.cwd();
        if (process.env.AGENTS_SESSION_DIR) {
          try {
            const reg = JSON.parse(
              fs.readFileSync(path.join(process.env.AGENTS_SESSION_DIR, "registration.json"), "utf8")
            );
            if (reg.task_dir) taskDir = reg.task_dir;
            if (reg.cwd) cwd = reg.cwd;
          } catch {}
        }

        const key = require("../lib/repo").repoKey(cwd);
        try {
          const result = require("../lib/worktree").add({
            projectDir: key.main_root,
            taskDir,
            name: taskDir ? null : name,
            force: false,
          });
          console.log(result.path);
        } catch (err) {
          if (err.code === "MANIFEST_OVERLAP") {
            process.stderr.write("Manifest overlap with live tasks:\n");
            for (const o of err.overlaps) {
              process.stderr.write(`  ${o.task}: ${o.files.join(", ")}\n`);
            }
          } else {
            process.stderr.write(`worktree create failed: ${err.message}\n`);
          }
          process.exit(1);
        }
        break;
      }

      case "land": {
        const taskDirInput = getArg(args, "--task-dir") || getArg(args, "--task");
        if (!taskDirInput) throw argError("--task-dir is required");
        const key = resolveRepo(args);
        const taskDir = resolveTaskDir(taskDirInput, key);
        const taskDirAbs = path.isAbsolute(taskDir) ? taskDir : path.resolve(key.main_root, taskDir);
        const taskLib = require("../lib/task");
        if (!taskLib.isMigrated(taskDirAbs)) throw argError("task not migrated; run `a task migrate` first");
        const phaseIdArg = getArg(args, "--phase-id");
        const phaseIds = phaseIdArg ? phaseIdArg.split(",").map((s) => parseInt(s.trim(), 10)) : null;
        const continueMode = args["--continue"] === true;
        try {
          const result = require("../lib/land").land({
            taskDir: taskDirAbs,
            projectDir: key.main_root,
            phaseIds,
            continueMode,
          });
          output(json, result);
        } catch (err) {
          if (err.name === "LockHeldError") {
            if (json) console.log(JSON.stringify({ error: "lock_held", holder: err.holder }));
            else process.stderr.write(`Landing lock held by ${err.holder.session_id} (pid ${err.holder.pid})\n`);
            process.exit(3);
          }
          throw err;
        }
        break;
      }

      case "hooks off":
      case "hooks on":
      case "hooks advise":
      case "hooks enforce":
      case "hooks status": {
        // D51 kill switch (off/on) and D57 advisory mode (advise/enforce):
        // flag files every hook checks before doing anything.
        const hookLib = require("../lib/hook");
        const flag = hookLib.hooksDisabledPath();
        const adviseFlag = hookLib.hooksAdvisePath();
        const touch = (f) => { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, new Date().toISOString() + "\n"); };
        const unlink = (f) => { try { fs.unlinkSync(f); } catch (err) { if (err.code !== "ENOENT") throw err; } };
        if (cmd === "off") touch(flag);
        else if (cmd === "on") unlink(flag);
        else if (cmd === "advise") touch(adviseFlag);
        else if (cmd === "enforce") unlink(adviseFlag);
        const mode = hookLib.hooksDisabled() ? "off" : hookLib.hooksAdvisory() ? "advise" : "enforce";
        if (json) output(json, { hooks: mode, flag, advise_flag: adviseFlag });
        else console.log(mode === "off"
          ? `hooks OFF (every hook exits 0; re-enable with: a hooks on)`
          : mode === "advise"
            ? `hooks ADVISE (denies and blocks become visible warnings; back to strict with: a hooks enforce)`
            : `hooks enforce`);
        break;
      }

      case "doctor": {
        // Hook-wiring + permissions check (the full `a doctor` is A10).
        // Verifies every AGENTS hook is registered in ~/.claude/settings.json,
        // that each hook script resolves `a`, that the central tasks root
        // is in permissions.additionalDirectories (D25), and which `a` the
        // hook stubs run (the installed snapshot, or the checkout fallback).
        const os = require("os");
        const stubA = require("../install-snapshot").resolveStubA(os.homedir());
        if (!json) process.stderr.write(`a (hook stubs): ${stubA.path || "(none)"} (via ${stubA.via})\n`);
        const installer = require("../install-global-hooks");
        const settings = installer.readSettings();
        const issues = [];
        for (const [event, entries] of Object.entries(installer.AGENTS_HOOKS)) {
          for (const entry of entries) {
            const script = entry.hooks[0].command.split("/").pop();
            const present = (settings.hooks && settings.hooks[event] || []).some(
              (e) => e.hooks && e.hooks.some((h) => h.command && h.command.includes(script))
            );
            if (!present) issues.push(`${event}/${script}: not registered in ~/.claude/settings.json`);
            const local = path.join(__dirname, "..", "..", "hooks", script);
            if (!fs.existsSync(local)) issues.push(`${script}: missing in hooks/`);
          }
        }
        if (!installer.isAdditionalDirPresent(settings)) {
          issues.push("permissions.additionalDirectories: missing ~/.agents/tasks (run ./install.sh)");
        }
        const aLink = path.join(os.homedir(), ".local", "bin", "a");
        if (!fs.existsSync(aLink)) issues.push("~/.local/bin/a: missing (run ./install.sh)");
        if (stubA.via === "checkout") issues.push("hook stubs fall back to the checkout; run ./install.sh");
        if (stubA.via === "none") issues.push("no installed a in ~/.agents/bin; run ./install.sh");
        let hookCount = 0;
        for (const entries of Object.values(installer.AGENTS_HOOKS)) hookCount += entries.length;
        // D44: check zmx is installed and at least version 0.8.1.
        const ccLib = require("../lib/cc");
        if (!ccLib.zmxAvailable()) {
          issues.push("zmx not installed (brew install neurosnap/tap/zmx); sessions will run in foreground or tmux (--tmux)");
        } else if (!ccLib.zmxVersionOk()) {
          issues.push("zmx version < 0.8.1; releases ≤ 0.8.1 replay only part of the scrollback on reattach");
        }
        // D47(5): report hook blocks per session for today from the hook log.
        // D50 item 3: honour AGENTS_LOGS_ROOT so tests isolating the log do
        // not inflate the counts, and print the path being counted.
        const hookLogPath = require("../lib/hook").hookLogPath();
        const blockCounts = {};
        if (fs.existsSync(hookLogPath)) {
          const today = new Date().toISOString().slice(0, 10);
          const logLines = fs.readFileSync(hookLogPath, "utf8").split("\n").filter(Boolean);
          for (const line of logLines) {
            const parts = line.split("\t");
            if (parts.length < 4) continue;
            const [ts, sid] = parts;
            if (!ts.startsWith(today)) continue;
            blockCounts[sid] = (blockCounts[sid] || 0) + 1;
          }
        }
        const blockEntries = Object.entries(blockCounts);
        if (!json) {
          process.stderr.write(`Hook log: ${hookLogPath}\n`);
          if (blockEntries.length > 0) {
            process.stderr.write("\nHook blocks today:\n");
            for (const [sid, count] of blockEntries) {
              process.stderr.write(`  ${sid}: ${count} block${count > 1 ? "s" : ""}\n`);
            }
          }
        }
        // D40: trash dir writable
        const warnings = [];
        const { trashRoot } = require("../lib/trash");
        const trashDirPath = trashRoot();
        try {
          fs.mkdirSync(trashDirPath, { recursive: true });
          const testFile = path.join(trashDirPath, ".doctor-write-test");
          fs.writeFileSync(testFile, "x");
          fs.unlinkSync(testFile);
        } catch {
          issues.push("trash dir not writable: " + trashDirPath);
        }
        // D40: last snapshot younger than 24h (warn, not fail)
        const { tasksRootBase } = require("../lib/tasks-root");
        const docRoot = tasksRootBase();
        if (fs.existsSync(path.join(docRoot, ".git"))) {
          try {
            const lastCommitTs = execSync("git log -1 --format=%ci", { cwd: docRoot, stdio: "pipe" }).toString().trim();
            const ageH = (Date.now() - new Date(lastCommitTs).getTime()) / 3600000;
            if (ageH > 24) warnings.push(`last snapshot ${Math.round(ageH)}h old (run: a tasks backup)`);
          } catch {}
        } else {
          warnings.push("central root is not a git repo (run: a tasks backup --init)");
        }
        // F5: hook library load check
        try {
          require("../lib/hook");
        } catch (loadErr) {
          issues.push(`hook library failed to load: ${loadErr.message}; hooks are fail-open but no guards are active; run \`a hooks off\` and fix the error`);
        }
        // F19: drift detection — compare installed agent files and hook stubs
        // against generated/, ignoring the `model:` frontmatter line.
        const repoRoot = path.resolve(__dirname, "..", "..");
        const installedAgentsDir = path.join(os.homedir(), ".claude", "agents");
        const generatedAgentsDir = path.join(repoRoot, "generated", "claude", "agents");
        if (fs.existsSync(generatedAgentsDir)) {
          for (const name of fs.readdirSync(generatedAgentsDir)) {
            if (!name.endsWith(".md")) continue;
            const installedPath = path.join(installedAgentsDir, name);
            const generatedPath = path.join(generatedAgentsDir, name);
            if (!fs.existsSync(installedPath)) {
              issues.push(`agent file ${name}: missing in ~/.claude/agents/ (run ./install.sh)`);
              continue;
            }
            try {
              const installed = fs.readFileSync(installedPath, "utf8");
              const generated = fs.readFileSync(generatedPath, "utf8");
              // Strip the model: line (the owner's launcher rewrites it)
              const stripModel = (s) => s.replace(/^model:.*$/gm, "");
              if (stripModel(installed) !== stripModel(generated)) {
                issues.push(`agent file ${name}: differs from generated/ (run ./install.sh)`);
              }
            } catch {}
          }
        }
        const installedHooksDir = path.join(os.homedir(), ".claude", "hooks");
        const sourceHooksDir = path.join(repoRoot, "hooks");
        if (fs.existsSync(sourceHooksDir)) {
          for (const name of fs.readdirSync(sourceHooksDir)) {
            if (!name.endsWith(".sh")) continue;
            const installedPath = path.join(installedHooksDir, name);
            const sourcePath = path.join(sourceHooksDir, name);
            if (!fs.existsSync(installedPath)) {
              issues.push(`hook stub ${name}: missing in ~/.claude/hooks/ (run ./install.sh)`);
              continue;
            }
            try {
              const installed = fs.readFileSync(installedPath, "utf8");
              const source = fs.readFileSync(sourcePath, "utf8");
              if (installed !== source) {
                issues.push(`hook stub ${name}: differs from hooks/ (run ./install.sh)`);
              }
            } catch {}
          }
        }
        // F4: payload-shape warning — check if the transcript fallback was used
        const logPath4 = require("../lib/hook").hookLogPath();
        if (fs.existsSync(logPath4)) {
          try {
            const logContent = fs.readFileSync(logPath4, "utf8");
            if (logContent.includes("transcript fallback") || logContent.includes("last_assistant_message")) {
              warnings.push("SubagentStop payloads on this CC version may omit `last_assistant_message`; report-parser uses the transcript fallback (D57)");
            }
          } catch {}
        }
        // F24: expired-lease warning — check tasks for expired leases with live bindings
        try {
          const sessionLib = require("../lib/session");
          const { tasksRootBase } = require("../lib/tasks-root");
          const root = tasksRootBase();
          if (fs.existsSync(root)) {
            for (const repoKey of fs.readdirSync(root)) {
              const repoDir = path.join(root, repoKey);
              if (!fs.statSync(repoDir).isDirectory()) continue;
              for (const taskDir of fs.readdirSync(repoDir)) {
                const taskJsonPath = path.join(repoDir, taskDir, "task.json");
                if (!fs.existsSync(taskJsonPath)) continue;
                try {
                  const task = JSON.parse(fs.readFileSync(taskJsonPath, "utf8"));
                  if (!task.lease || !task.lease.session_id) continue;
                  const expiresAt = new Date(task.lease.expires_at).getTime();
                  if (Date.now() < expiresAt) continue;
                  const bindingDir = sessionLib.resolveSessionDir(task.lease.session_id);
                  const binding = sessionLib.readRegistration(bindingDir);
                  if (binding && !binding.ended_at) {
                    warnings.push(`lease held by expired session ${task.lease.session_id}; binding is live — run \`a next\` or touch the task to re-key`);
                  }
                } catch {}
              }
            }
          }
        } catch {}
        if (issues.length === 0) {
          const docResult = { ok: true, hooks: hookCount, message: "all hooks registered and resolving", a_resolves_to: stubA.path, a_via: stubA.via };
          if (blockEntries.length > 0) docResult.hook_blocks = blockCounts;
          if (warnings.length > 0) docResult.warnings = warnings;
          // D51: say loudly when the kill switch is on.
          const hookLib = require("../lib/hook");
          docResult.hooks = hookLib.hooksDisabled() ? "off" : hookLib.hooksAdvisory() ? "advise" : "enforce";
          if (docResult.hooks === "off") process.stderr.write(`\nHOOKS ARE OFF (${hookLib.hooksDisabledPath()}); re-enable with: a hooks on\n`);
          if (docResult.hooks === "advise") process.stderr.write(`\nHooks are ADVISORY (${hookLib.hooksAdvisePath()}): denies and blocks are shown, not applied; strict again with: a hooks enforce\n`);
          if (!json && warnings.length > 0) for (const w of warnings) process.stderr.write("WARN: " + w + "\n");
          output(json, docResult);
        } else {
          output(json, { ok: false, issues, a_resolves_to: stubA.path, a_via: stubA.via });
          if (!json) for (const i of issues) process.stderr.write(i + "\n");
          process.exit(1);
        }
        break;
      }

      default:
        process.stderr.write(`Usage: a <group> <cmd> [--json] ...\n`);
        process.stderr.write(groupsLine() + "\n");
        process.stderr.write(`  task migrate: dry-run by default; pass --apply to write (backs up task.md to task.md.v1)\n`);
        process.stderr.write(`  Run \`a --help\` or \`a <group> <cmd> --help\` for details.\n`);
        process.exit(2);
    }
  } catch (err) {
    if (err.name === "LockHeldError") {
      if (json) console.log(JSON.stringify({ error: "lock_held", holder: err.holder }));
      else process.stderr.write(`Lock held by ${err.holder.session_id} (pid ${err.holder.pid})\n`);
      process.exit(3);
    }
    if (err.notFound) {
      if (json) console.log(JSON.stringify({ error: "not_found", message: err.message }));
      else process.stderr.write(err.message + "\n");
      process.exit(4);
    }
    if (json) console.log(JSON.stringify({ error: "validation", message: err.message }));
    else process.stderr.write(err.message + "\n");
    process.exit(2);
  }
}

function argError(msg) {
  const e = new Error(msg);
  e.name = "ArgError";
  return e;
}

function notFoundError(msg) {
  const e = new Error(msg);
  e.notFound = true;
  return e;
}

function slugify(text) {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
}

