  { g: "state", c: "prime", d: "Print task progress for session priming.",
    f: [["--task-dir", true, "<dir>", "task directory"]],
    ex: "a state prime --task-dir 128" },
  { g: "next", c: null, d: "Compute the next step for a task.",
    f: [["--task-dir", true, "<dir>", "task directory"]],
    ex: "a next --task-dir 128" },
  { g: "report", c: null, d: "Persist an agent report for a phase.",
    f: [["--task-dir", true, "<dir>", "task directory"], ["--phase-id", true, "<n>", "phase id"], ["--agent", true, "<name>", "explorer|builder|reviewer|committer"], ["--report-json", false, "<json>", "report object (or stdin)"]],
    ex: "a report --task-dir 128 --phase-id 1 --agent builder --report-json '{}'" },
  { g: "checkpoint", c: "open", d: "Open a checkpoint on a phase.",
    f: [["--task-dir", true, "<dir>", "task directory"], ["--phase-id", true, "<n>", "phase id"], ["--type", true, "<type>", "checkpoint type"], ["--question", true, "<text>", "question text"], ["--options-json", false, "<json>", "options array"]],
    ex: 'a checkpoint open --task-dir 128 --phase-id 1 --type approve --question "Proceed?"' },
  { g: "checkpoint", c: "resolve", d: "Resolve a checkpoint.",
    f: [["--task-dir", true, "<dir>", "task directory"], ["--checkpoint-id", true, "<id>", "checkpoint id"], ["--chosen", true, "<text>", "chosen option"]],
    ex: "a checkpoint resolve --task-dir 128 --checkpoint-id c1 --chosen yes" },
  { g: "plan", c: "lint", d: "Lint a plan file.",
    f: [["--file", true, "<path>", "plan file or task.md"]],
    ex: "a plan lint --file .tasks/128-foo/plan/phase-1.md" },
  { g: "policy", c: null, d: "Resolve the push/ln/merge policy for a repo.",
    f: [["--path", false, "<path>", "path inside the repo (default: cwd)"]],
