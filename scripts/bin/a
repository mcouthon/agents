    ex: "a tasks ls --tier strategic" },
  { g: "tasks", c: "show", d: "Show a task: state.md + overview + next step.",
    f: [["--task-dir", false, "<dir>", "task directory or slug"]],
    ex: "a tasks show 128" },
  { g: "tasks", c: "sweep", d: "List or close done tasks by disposition.",
    f: [["--older-than", false, "<Nd>", "only tasks older than N days"], ["--apply", false, "", "close tasks instead of listing"]],
    ex: "a tasks sweep --older-than 7d" },
  { g: "tasks", c: "doctrine", d: "Set the default-tier table for a repo.",
    f: [["--repo", false, "<path>", "repo path (default: cwd)"]],
    ex: 'a tasks doctrine \'{"default":"standard","courier":"minor"}\'' },
  { g: "tasks", c: "backup", d: "Snapshot the central root to git (--init sets up the repo and launchd agent).",
    f: [["--init", false, "", "create git repo, first commit, and launchd agent"]],
    ex: "a tasks backup --init" },
  { g: "trash", c: "ls", d: "List trashed task directories with age.",
    f: [["--older-than", false, "<Nd>", "only entries older than N days"]],
    ex: "a trash ls --older-than 30d" },
  { g: "trash", c: "purge", d: "Delete trashed entries older than N days (the only deleter).",
    f: [["--older-than", true, "<Nd>", "required: only entries older than N days"]],
    ex: "a trash purge --older-than 30d" },
  { g: "state", c: "update", d: "Update phase status, owner, task status, or commits.",
    f: [["--task-dir", true, "<dir>", "task directory"], ["--phase-id", false, "<n>", "phase id"], ["--phase-status", false, "<s>", "new phase status"], ["--owner", false, "<name>", "phase owner"], ["--task-status", false, "<s>", "task status"], ["--started", false, "", "mark task started"], ["--completed", false, "", "mark task completed"], ["--blocked-by", false, "<ids>", "comma-separated phase ids"], ["--parallel-group", false, "<name>", "parallel group"], ["--commits", false, "<sha,sha>", "comma-separated commit SHAs"], ["--counter", false, "<name=n,…>", "set phase counters (review_passes, fix_attempts, ci_attempts, clarify_rounds, autofix_ran)"]],
    ex: "a state update --task-dir 128 --phase-id 1 --phase-status in_progress" },
  { g: "state", c: "flag", d: "Add a flag to a phase.",
    f: [["--task-dir", true, "<dir>", "task directory"], ["--phase-id", true, "<n>", "phase id"], ["--type", true, "<type>", "flag type"], ["--message", true, "<text>", "flag message"]],
    ex: 'a state flag --task-dir 128 --phase-id 1 --type warning --message "blocked"' },
  { g: "state", c: "clear-flag", d: "Remove a flag by id.",
    f: [["--task-dir", true, "<dir>", "task directory"], ["--flag-id", true, "<id>", "flag id"]],
    ex: "a state clear-flag --task-dir 128 --flag-id f1" },
  { g: "state", c: "add-phases", d: "Append phases to a task.",
    f: [["--task-dir", true, "<dir>", "task directory"], ["--phases-json", true, "<json>", "phase definitions array"]],
