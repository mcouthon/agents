#!/bin/sh
# AGENTS framework -- launch Claude Code Builder agent
set -e
AGENT="Builder"
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname -- "$self")/$link ;;
  esac
done
dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
. "$dir/_a-common.sh"
a_main "$@"
