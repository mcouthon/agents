{
  "explorer": {
    "type": "object",
    "required": ["plan_path", "manifest", "open_questions", "summary"],
    "properties": {
      "plan_path": { "type": "string", "description": "Relative path to the phase plan file" },
      "manifest": {
        "type": "array", "items": { "type": "string" },
        "description": "Files the plan intends to modify"
      },
      "open_questions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["question"],
          "properties": {
            "question": { "type": "string" },
            "options": { "type": "array", "items": { "type": "string" } }
          }
        },
        "description": "Unresolved questions that need human input"
      },
      "summary": { "type": "string", "description": "Brief plan summary" }
    },
    "additionalProperties": false
  },
  "reviewer": {
    "type": "object",
    "required": ["verdict", "issues", "summary"],
    "properties": {
      "verdict": { "type": "string", "enum": ["pass", "pass_with_notes", "needs_work", "fail"] },
      "attributed_to": { "type": "string", "enum": ["reviewer", "user"], "description": "Who issued the verdict (D31); user = a human resolved the review at a checkpoint" },
      "issues": {
        "type": "array",
        "description": "Each issue with severity, file, line, and text (description is an alias for text; blocking/warning are aliases for red/yellow)",
        "items": {
          "type": "object",
          "required": ["severity", "file", "line", "text"],
          "properties": {
            "severity": { "type": "string", "enum": ["red", "yellow", "blocking", "warning"] },
            "file": { "type": "string" },
            "line": { "type": ["string", "null"] },
            "text": { "type": "string" },
            "description": { "type": "string", "description": "Alias for text (normalised to text before storage)" }
          }
        }
      },
      "summary": { "type": "string" }
    },
    "additionalProperties": false
  },
  "builder": {
    "type": "object",
    "required": ["files_touched", "verification", "deviations", "summary"],
    "properties": {
      "files_touched": {
        "type": "array", "items": { "type": "string" },
        "description": "Every file the builder modified"
      },
      "verification": {
        "type": "array",
        "description": "Each validation command with exit code and summary",
        "items": {
          "type": "object",
          "required": ["cmd", "exit", "summary"],
          "properties": {
            "cmd": { "type": "string" },
            "exit": { "type": "integer" },
            "summary": { "type": "string" }
          }
        }
      },
      "deviations": {
        "type": "array", "items": { "type": "string" },
        "description": "Deviations from the plan, if any"
      },
      "summary": { "type": "string", "description": "One-paragraph implementation summary" }
    },
    "additionalProperties": false
  },
  "committer": {
    "type": "object",
    "required": ["commits"],
    "properties": {
      "commits": {
        "type": "array",
        "description": "Each commit with its files and conventional-commit message",
        "items": {
          "type": "object",
          "required": ["files", "message"],
          "properties": {
            "sha": { "type": "string", "description": "Commit SHA (optional; recorded into phase.commits when present, D34)" },
            "files": { "type": "array", "items": { "type": "string" } },
            "message": { "type": "string" }
          }
        }
      }
    },
    "additionalProperties": false
  },
  "consolidator": {
    "type": "object",
    "required": ["distilled_to", "proposals"],
    "properties": {
      "distilled_to": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Paths to files where the task's distilled knowledge was written (ADRs, docs, instruction deltas)"
      },
      "proposals": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Proposed instruction changes for future agents"
      }
    },
    "additionalProperties": false
  }
}
