{
    "models": {
        "opus": "5",
        "sonnet": "5",
        "haiku": "4.5"
    },
    "agents": {
        "researcher": {
            "copilot": "haiku"
        },
        "committer": {
            "copilot": "haiku"
        }
    },
    "defaultTools": {
        "copilot": [
            "graphifyy/*"
        ],
        "cc": []
    },
    "agentTools": {
        "copilot": {},
        "cc": {
            "explorer": [
                "mcp__graphifyy__*",
                "mcp__state-manager__code_index_status"
            ],
            "researcher": [
                "mcp__graphifyy__*"
            ],
            "reviewer": [
                "mcp__graphifyy__*"
            ],
            "builder": [
                "mcp__graphifyy__*",
                "mcp__state-manager__code_index_build"
            ]
        }
    },
    "mcpServers": {
        "graphify": {
            "displayName": "Graphify",
            "toolNames": { "copilot": "graphifyy/*", "cc": "mcp__graphifyy__*" },
            "salience": "preferred",
            "agents": ["explorer", "builder", "reviewer", "researcher"],
            "hint": "for tracing symbols, usages and cross-file structure",
            "callingConvention": "fall back to LSP/Grep when it returns nothing or the index is stale"
        }
    }
}
